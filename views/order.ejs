<!-- ============================================================
  VIEW: order.ejs — Formulario "Arma tu pedido" (multi-paso)
  ------------------------------------------------------------
  4 pasos: 1) Pizzas (tamaño, cantidad y toppings) con steppers
  táctiles +/−, 2) ¿Desea bebidas?, 3) Bebidas, 4) Datos de
  contacto y método de pago. Incluye resumen/total en vivo.
  Variables: pizzas, sizes, toppings, prices, bebidas.
============================================================ -->
<!DOCTYPE html>
<html lang="es" class="dark">
<head>
  <%- include('partials/head', { title: 'Arma tu pedido — Bella Napoli' }) %>
  <style>
    @keyframes pop {
      0% { transform: scale(1); }
      50% { transform: scale(1.3); }
      100% { transform: scale(1); }
    }
    .animate-pop {
      animation: pop 0.3s ease;
    }
    .custom-checkbox:checked {
      background-image: url("data:image/svg+xml,%3csvg viewBox='0 0 16 16' fill='white' xmlns='http://www.w3.org/2000/svg'%3e%3cpath d='M12.207 4.793a1 1 0 010 1.414l-5 5a1 1 0 01-1.414 0l-2-2a1 1 0 011.414-1.414L6.5 9.086l4.293-4.293a1 1 0 011.414 0z'/%3e%3c/svg%3e");
      background-size: 100% 100%;
      background-position: center;
      background-repeat: no-repeat;
    }
    .custom-checkbox.no-hover:hover {
      background-color: transparent !important;
      border-color: #444748 !important;
    }
    .step-input {
      background: transparent;
      border: 0;
      border-bottom: 1px solid #fff5e6;
      color: #fff5e6;
      padding: 0.5rem 0;
      font-family: 'Manrope', sans-serif;
    }
    .step-input:focus {
      outline: none;
      border-color: #d32f2f;
    }
  </style>
</head>
<body class="bg-background text-on-background min-h-screen relative overflow-x-hidden font-sans">
  <div class="texture-overlay"></div>

  <header class="sticky top-0 z-50 bg-surface/95 backdrop-blur-sm border-b border-outline-variant/30">
    <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-3 flex justify-between items-center">
      <a href="/" class="flex items-center gap-3">
        <span class="text-3xl">🍕</span>
        <h1 class="font-display text-headline-md text-on-surface hover:opacity-80 transition-opacity">Bella Napoli</h1>
      </a>
      <div class="flex items-center gap-4">
        <span class="font-sans text-body-md text-on-surface-variant">Hola, <%= currentUser.name %></span>
        <a href="/logout" class="bg-transparent border border-brand-red text-brand-cream px-5 py-2 font-label-caps text-label-caps rounded-none hover:bg-brand-red transition-colors duration-300">Salir</a>
      </div>
    </div>
  </header>

  <main class="max-w-4xl mx-auto px-margin-mobile md:px-margin-desktop py-10">
    <h2 class="font-display text-headline-lg text-brand-cream text-center mb-10">Arma tu pedido</h2>
    <span class="block text-center font-sans text-label-caps text-brand-red mb-10 uppercase tracking-widest">Rosso e Nero · Tradición artesanal</span>

    <form action="/order" method="POST" id="orderForm">
      <%- include('csrf') %>

      <!-- Paso 1: Pizzas -->
      <section id="step-1" class="step">
        <h3 class="font-display text-headline-md mb-6 text-brand-cream">🍕 Elige tus pizzas</h3>
        <% pizzas.forEach((pizza, idx) => { %>
          <div class="bg-primary-container border border-outline-variant/40 hover:border-brand-red/50 transition-all mb-4 overflow-hidden">
            <div class="p-5 flex items-center justify-between cursor-pointer select-none" onclick="this.parentElement.querySelector('.pizza-check').click()">
              <div class="flex items-center space-x-4">
                <input type="checkbox" name="pizzas[<%= idx %>][selected]" value="1"
                    class="appearance-none h-6 w-6 rounded border-2 border-outline bg-transparent cursor-pointer transition-all duration-200 ease-in-out
                            hover:border-brand-red
                            focus:outline-none focus:ring-4 focus:ring-brand-red/30
                            checked:bg-brand-red checked:border-brand-red
                            pizza-check custom-checkbox"
                    onclick="event.stopPropagation()">
                <div>
                  <h3 class="font-display text-headline-md text-on-surface"><%= pizza.name %></h3>
                  <p class="font-sans text-body-md text-on-surface-variant"><%= pizza.description %></p>
                </div>
              </div>
              <span class="text-on-surface-variant font-sans text-body-md">
                <% if (prices[pizza.id]) { %>
                  Desde $<%= Math.min(...Object.values(prices[pizza.id])).toFixed(2) %>
                <% } %>
              </span>
            </div>
            <div class="pizza-options hidden border-t border-outline-variant/40 bg-surface-container-low px-5 py-4" id="options-<%= idx %>">
              <div class="grid grid-cols-2 gap-4">
                <label class="block">
                  <span class="font-sans text-body-md text-on-surface-variant">Tamaño</span>
                  <select name="pizzas[<%= idx %>][size]" class="size-select mt-1 block w-full rounded-none bg-surface-container border border-outline-variant text-on-surface font-sans">
                    <% sizes.forEach(size => { %>
                      <option value="<%= size.id %>"><%= size.label %></option>
                    <% }) %>
                  </select>
                </label>
                <label class="block">
                  <span class="font-sans text-body-md text-on-surface-variant">Cantidad</span>
                  <div class="flex items-center mt-1 gap-1">
                    <button type="button" data-step-down="pizza-qty-<%= idx %>"
                            class="stepper-btn w-9 h-9 rounded-full bg-transparent border border-brand-cream text-brand-cream font-bold text-lg leading-none select-none active:bg-white/10 transition"
                            aria-label="Disminuir">−</button>
                    <input type="number" name="pizzas[<%= idx %>][quantity]" id="pizza-qty-<%= idx %>"
                           min="1" max="30" value="1" step="1"
                           onkeydown="return false;"
                           class="quantity-input w-14 text-center bg-transparent border border-outline-variant text-on-surface font-sans py-2 mx-1">
                    <button type="button" data-step-up="pizza-qty-<%= idx %>"
                            class="stepper-btn w-9 h-9 rounded-full bg-transparent border border-brand-cream text-brand-cream font-bold text-lg leading-none select-none active:bg-white/10 transition"
                            aria-label="Aumentar">+</button>
                  </div>
                </label>
              </div>
              <div class="mt-4">
                <span class="font-sans text-body-md text-on-surface-variant">Ingredientes extra</span>
                <div class="grid grid-cols-2 md:grid-cols-4 gap-2 mt-2">
                  <% toppings.forEach(topping => { %>
                    <label class="flex items-center space-x-2 bg-surface-container p-2 rounded-none border border-outline-variant hover:border-brand-red/60 transition cursor-pointer">
                      <input type="checkbox" name="pizzas[<%= idx %>][toppings][]" value="<%= topping.id %>"
                             class="topping-check form-checkbox h-4 w-4 text-brand-red rounded">
                      <span class="font-sans text-body-md text-on-surface"><%= topping.name %> (+$<%= topping.extra_price.toFixed(2) %>)</span>
                    </label>
                  <% }) %>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
        <button type="button" onclick="nextStep(2)" class="w-full bg-brand-red hover:bg-red-800 text-brand-cream font-label-caps text-label-caps text-lg py-4 rounded-none shadow-xl transition">
          Siguiente →
        </button>
      </section>

      <!-- Paso 2: Pregunta por bebidas -->
      <section id="step-2" class="step hidden">
        <h3 class="font-display text-headline-md mb-6 text-brand-cream">¿Deseas agregar bebidas o acompañantes?</h3>
        <div class="flex gap-4">
          <button type="button" onclick="chooseBebidas(true)" class="bg-brand-red hover:bg-red-800 text-brand-cream font-label-caps text-label-caps py-3 px-8 rounded-none transition">Sí, quiero bebidas</button>
          <button type="button" onclick="chooseBebidas(false)" class="bg-surface-container hover:bg-surface-container-high text-on-surface font-label-caps text-label-caps py-3 px-8 rounded-none border border-outline-variant transition">No, gracias</button>
        </div>
        <button type="button" onclick="prevStep(1)" class="mt-6 text-on-surface-variant hover:text-brand-cream transition font-sans text-body-md">← Atrás</button>
      </section>

      <!-- Paso 3: Bebidas (si eligió sí) -->
      <section id="step-3" class="step hidden">
        <h3 class="font-display text-headline-md mb-6 text-brand-cream">🥤 Bebidas</h3>
        <% bebidas.forEach(bebida => { %>
          <div class="bg-primary-container border border-outline-variant/40 hover:border-brand-red/50 transition-all mb-4 p-5 flex items-center justify-between">
            <div class="flex items-center space-x-4">
              <span class="text-3xl">🥤</span>
              <div>
                <h3 class="font-display text-headline-md text-on-surface"><%= bebida.name %></h3>
                <p class="font-sans text-body-md text-on-surface-variant">$<%= bebida.price.toFixed(2) %></p>
              </div>
            </div>
            <div class="flex items-center space-x-2">
              <label class="font-sans text-body-md text-on-surface-variant">Cantidad</label>
              <div class="flex items-center gap-1">
                <button type="button" data-step-down="bebida-qty-<%= bebida.id %>"
                        class="stepper-btn w-8 h-8 rounded-full bg-transparent border border-brand-cream text-brand-cream font-bold text-lg leading-none select-none active:bg-white/10 transition"
                        aria-label="Disminuir">−</button>
                <input type="number" name="bebidas[<%= bebida.id %>]" id="bebida-qty-<%= bebida.id %>" min="0" max="30" value="0" step="1"
                       onkeydown="return false;"
                       class="bebida-qty w-12 text-center bg-transparent border border-outline-variant text-on-surface font-sans py-1.5 mx-1 quantity-input">
                <button type="button" data-step-up="bebida-qty-<%= bebida.id %>"
                        class="stepper-btn w-8 h-8 rounded-full bg-transparent border border-brand-cream text-brand-cream font-bold text-lg leading-none select-none active:bg-white/10 transition"
                        aria-label="Aumentar">+</button>
              </div>
            </div>
          </div>
        <% }) %>
        <button type="button" onclick="nextStep(4)" class="w-full bg-brand-red hover:bg-red-800 text-brand-cream font-label-caps text-label-caps text-lg py-4 rounded-none shadow-xl transition">
          Siguiente →
        </button>
        <button type="button" onclick="prevStep(2)" class="mt-4 text-on-surface-variant hover:text-brand-cream transition font-sans text-body-md">← Atrás</button>
      </section>

      <!-- Paso 4: Datos de contacto -->
      <section id="step-4" class="step hidden">
        <div class="bg-primary-container border border-outline-variant/40 p-6 mb-6">
          <h3 class="font-display text-headline-md mb-6 text-brand-cream">Datos de contacto</h3>
          <div class="grid md:grid-cols-2 gap-6">
            <label class="block">
              <span class="font-sans text-body-md text-on-surface-variant">Teléfono</span>
              <input type="tel" name="phone" id="phoneInput" required 
                     placeholder="0000-0000000" maxlength="12"
                     pattern="^\d{4}-\d{7}$" 
                     class="mt-1 block w-full step-input">
              <span id="phoneError" class="text-brand-red text-sm hidden mt-1 font-sans">⛔ Código de área inexistente</span>
            </label>
            <label class="block">
              <span class="font-sans text-body-md text-on-surface-variant">Hora de recogida</span>
              <input type="time" name="pickup_time" id="pickupTime" required
              min="17:00" max="23:59"
              class="mt-1 block w-full step-input">
              <span id="timeError" class="text-brand-red text-sm hidden mt-1 font-sans">⛔ El horario de recogida es de 5:00 PM a 11:59 PM</span>
            </label>
            <label class="block md:col-span-2">
              <span class="font-sans text-body-md text-on-surface-variant">Método de pago</span>
              <select name="payment_method" id="paymentMethod" required 
                      class="mt-1 block w-full rounded-none bg-surface-container border border-outline-variant text-on-surface font-sans">
                <option value="">Selecciona...</option>
                <option value="Efectivo en local">Efectivo en local</option>
                <option value="Pago móvil">Pago móvil</option>
                <option value="Transferencia bancaria">Transferencia bancaria</option>
                <option value="Binance">Binance</option>
                <option value="Zelle">Zelle</option>
              </select>
            </label>
          </div>
        </div>

        <div id="orderSummary" class="bg-surface-container border border-outline-variant/40 p-6 mb-6 hidden border-l-4 border-l-brand-red">
          <h3 class="font-display text-headline-md text-brand-cream mb-4">Tu pedido</h3>
          <ul id="summaryList" class="space-y-2 font-sans text-body-md text-on-surface"></ul>
          <div class="flex justify-between items-center mt-4 pt-4 border-t border-outline-variant">
            <span class="font-sans text-body-lg text-on-surface font-bold">Total</span>
            <span class="font-display text-price-display text-brand-red">$<span id="totalPrice">0.00</span></span>
          </div>
        </div>

        <button type="submit" id="submitOrderBtn" class="w-full bg-brand-red hover:bg-red-800 text-brand-cream font-label-caps text-label-caps text-lg py-4 rounded-none shadow-xl transition">
          Enviar pedido 🍕
        </button>
        <button type="button" onclick="prevStep(3)" class="mt-4 text-on-surface-variant hover:text-brand-cream transition font-sans text-body-md">← Atrás</button>
      </section>
    </form>
  </main>

  <!-- Datos del servidor para JavaScript -->
  <script id="prices-data" type="application/json"><%- JSON.stringify(prices) %></script>
  <script id="toppings-data" type="application/json"><%- JSON.stringify(toppings) %></script>
  <script id="names-data" type="application/json"><%- JSON.stringify(pizzas.map(p => p.name)) %></script>
  <script id="bebidas-data" type="application/json"><%- JSON.stringify(bebidas) %></script>

  <script>
    const pizzaPrices = JSON.parse(document.getElementById('prices-data').textContent);
    const toppingsList = JSON.parse(document.getElementById('toppings-data').textContent);
    const pizzaNames = JSON.parse(document.getElementById('names-data').textContent);
    const checkboxes = document.querySelectorAll('.pizza-check');
    const orderSummary = document.getElementById('orderSummary');
    const summaryList = document.getElementById('summaryList');
    const totalSpan = document.getElementById('totalPrice');
    const bebidasList = JSON.parse(document.getElementById('bebidas-data').textContent);

    // Control de pasos
    let currentStep = 1;
    let wantsBebidas = false;

    function showStep(step) {
      document.querySelectorAll('.step').forEach(s => s.classList.add('hidden'));
      document.getElementById('step-' + step).classList.remove('hidden');
      currentStep = step;
    }

    function nextStep(step) {
      showStep(step);
    }

    function prevStep(step) {
      if (currentStep === 4 && !wantsBebidas) {
        showStep(2);
      } else {
        showStep(step);
      }
    }

    function chooseBebidas(wants) {
      wantsBebidas = wants;
      if (wants) {
        showStep(3);
      } else {
        showStep(4);
      }
    }

    function updateSummary() {
      let total = 0;
      summaryList.innerHTML = '';

      checkboxes.forEach(cb => {
        if (cb.checked) {
          const idxMatch = cb.name.match(/\[(\d+)\]/);
          if (!idxMatch) return;
          const idx = parseInt(idxMatch[1]);
          const pizzaId = idx + 1;

          const optionsDiv = document.getElementById(`options-${idx}`);
          const sizeSelect = optionsDiv.querySelector('.size-select');
          const sizeId = sizeSelect.value;
          const qtyInput = optionsDiv.querySelector('.quantity-input');
          const quantity = parseInt(qtyInput.value) || 1;

          const pizzaName = pizzaNames[idx];

          let basePrice = 0;
          if (pizzaPrices[pizzaId] && pizzaPrices[pizzaId][sizeId]) {
            basePrice = pizzaPrices[pizzaId][sizeId];
          }

          const toppingChecks = optionsDiv.querySelectorAll('.topping-check:checked');
          let extrasCost = 0;
          const selectedToppings = [];
          toppingChecks.forEach(tc => {
            const toppingId = parseInt(tc.value);
            const topping = toppingsList.find(t => t.id === toppingId);
            if (topping) {
              extrasCost += topping.extra_price;
              selectedToppings.push(topping.name);
            }
          });

          const lineTotal = (basePrice + extrasCost) * quantity;
          total += lineTotal;

          const li = document.createElement('li');
          let text = `${quantity}x ${pizzaName} (${sizeSelect.options[sizeSelect.selectedIndex].text})`;
          if (selectedToppings.length) {
            text += ` + ${selectedToppings.join(', ')}`;
          }
          text += ` = $${lineTotal.toFixed(2)}`;
          li.textContent = text;
          summaryList.appendChild(li);
        }
      });

      document.querySelectorAll('.bebida-qty').forEach(input => {
        const qty = parseInt(input.value) || 0;
        if (qty > 0) {
          const bebidaId = input.name.match(/\[(\d+)\]/)[1];
          const bebida = bebidasList.find(b => b.id == bebidaId);
          if (bebida) {
            const lineTotal = bebida.price * qty;
            total += lineTotal;

            const li = document.createElement('li');
            li.textContent = `${qty}x ${bebida.name} = $${lineTotal.toFixed(2)}`;
            summaryList.appendChild(li);
          }
        }
      });

      totalSpan.textContent = total.toFixed(2);
      orderSummary.classList.toggle('hidden', total === 0);
    }

    checkboxes.forEach(cb => {
      cb.addEventListener('change', function() {
        const idx = Array.from(checkboxes).indexOf(this);
        const optionsDiv = document.getElementById(`options-${idx}`);
        optionsDiv.classList.toggle('hidden', !this.checked);
        if (!this.checked) {
          optionsDiv.querySelectorAll('.topping-check').forEach(t => t.checked = false);
          optionsDiv.querySelector('.quantity-input').value = 1;
        }
        updateSummary();
        this.classList.add('animate-pop');
        setTimeout(() => this.classList.remove('animate-pop'), 300);
        this.classList.add('no-hover');
        setTimeout(() => this.classList.remove('no-hover'), 150);
      });
    });

    document.querySelectorAll('.size-select, .quantity-input, .topping-check, .bebida-qty').forEach(el => {
      el.addEventListener('change', updateSummary);
    });

    // Steppers de cantidad (funcionan también en dispositivos móviles)
    function stepQty(id, delta) {
      const input = document.getElementById(id);
      if (!input) return;
      const min = parseInt(input.min || 0);
      const max = input.max ? parseInt(input.max) : Infinity;
      const current = parseInt(input.value) || 0;
      const next = Math.min(Math.max(current + delta, min), max);
      input.value = next;
      input.dispatchEvent(new Event('change', { bubbles: true }));
    }

    document.querySelectorAll('.stepper-btn').forEach(btn => {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        const target = btn.dataset.stepUp ? btn.dataset.stepUp : btn.dataset.stepDown;
        const delta = btn.dataset.stepUp ? 1 : -1;
        stepQty(target, delta);
        return false;
      });
    });

    // Validación de teléfono
    const validAreaCodes = ['0412', '0414', '0416', '0422', '0424', '0426'];
    const phoneInput = document.getElementById('phoneInput');
    const phoneError = document.getElementById('phoneError');

    function validateAreaCode(value) {
      const cleaned = value.replace(/\D/g, '');
      if (cleaned.length < 4) return true;
      const code = cleaned.substring(0, 4);
      return validAreaCodes.includes(code);
    }

    function updatePhoneUI() {
      const val = phoneInput.value;
      if (val.replace(/\D/g, '').length < 4) {
        phoneError.classList.add('hidden');
        phoneInput.classList.remove('border-red-500');
        return;
      }
      if (!validateAreaCode(val)) {
        phoneError.classList.remove('hidden');
        phoneInput.classList.add('border-red-500');
      } else {
        phoneError.classList.add('hidden');
        phoneInput.classList.remove('border-red-500');
      }
    }

    phoneInput.addEventListener('keydown', function(e) {
      if (e.key === 'Backspace') {
        const value = this.value;
        const cursorPos = this.selectionStart;
        if (value.charAt(4) === '-' && cursorPos === 5) {
          e.preventDefault();
          const newValue = value.substring(0, 3) + value.substring(4);
          this.value = newValue;
          this.setSelectionRange(3, 3);
          this.dispatchEvent(new Event('input'));
        }
      }
    });

    phoneInput.addEventListener('input', function(e) {
      let value = this.value.replace(/\D/g, '');
      if (value.length >= 4) {
        value = value.substring(0,4) + '-' + value.substring(4,11);
      }
      this.value = value;
      updatePhoneUI();
    });

    phoneInput.addEventListener('paste', function(e) {
      e.preventDefault();
      const cleaned = (e.clipboardData || window.clipboardData).getData('text').replace(/\D/g, '');
      let formatted = cleaned.substring(0,4);
      if (cleaned.length > 4) formatted += '-' + cleaned.substring(4,11);
      this.value = formatted;
      updatePhoneUI();
    });

    document.getElementById('orderForm').addEventListener('submit', function(e) {
      if (!validateAreaCode(phoneInput.value)) {
        e.preventDefault();
        phoneError.classList.remove('hidden');
        phoneInput.classList.add('border-red-500');
        phoneInput.focus();
      }
    });

    // Validación de hora
    const pickupTimeInput = document.getElementById('pickupTime');
    const timeError = document.getElementById('timeError');

    function validatePickupTime() {
      const value = pickupTimeInput.value;
      if (!value) {
        timeError.classList.add('hidden');
        pickupTimeInput.classList.remove('border-red-500');
        return true;
      }

      const [hours, minutes] = value.split(':').map(Number);
      const totalMinutes = hours * 60 + minutes;

      if (totalMinutes < 17 * 60 || totalMinutes > 23 * 60 + 59) {
        timeError.classList.remove('hidden');
        pickupTimeInput.classList.add('border-red-500');
        return false;
      } else {
        timeError.classList.add('hidden');
        pickupTimeInput.classList.remove('border-red-500');
        return true;
      }
    }

    pickupTimeInput.addEventListener('input', validatePickupTime);
    pickupTimeInput.addEventListener('change', validatePickupTime);

    document.getElementById('orderForm').addEventListener('submit', function(e) {
      if (!validatePickupTime()) {
        e.preventDefault();
        pickupTimeInput.focus();
      }
    });

    // Botón dinámico de pago
    const paymentMethodSelect = document.getElementById('paymentMethod');
    const submitBtn = document.getElementById('submitOrderBtn');

    function updateButtonText() {
      const method = paymentMethodSelect.value;
      if (method === 'Efectivo en local') {
        submitBtn.textContent = 'Enviar pedido 🍕';
      } else {
        submitBtn.textContent = 'Realizar pago 💳';
      }
    }

    paymentMethodSelect.addEventListener('change', updateButtonText);
    updateButtonText();

    updatePhoneUI();
    updateSummary();
  </script>

</body>
</html>