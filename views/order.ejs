<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>🍕 Realizar pedido - Bella Napoli</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; }
    h1, h2, h3, .font-serif { font-family: 'Playfair Display', serif; }
    @keyframes pop {
      0% { transform: scale(1); }
      50% { transform: scale(1.3); }
      100% { transform: scale(1); }
    }
    .animate-pop {
      animation: pop 0.3s ease;
    }
    .custom-checkbox:checked {
      background-image: url("data:image/svg+xml,%3csvg viewBox='0 0 16 16' fill='white' xmlns='http://www.w3.org/2000/svg'%3e%3cpath d='M12.207 4.793a1 1 0 010 1.414l-5 5a1 1 0 01-1.414 0l-2-2a1 1 0 011.414-1.414L6.5 9.086l4.293-4.293a1 1 0 011.414 0z'/%3e%3c/svg%3e");
      background-size: 100% 100%;
      background-position: center;
      background-repeat: no-repeat;
    }
    .custom-checkbox.no-hover:hover {
      background-color: white !important;
      border-color: #d1d5db !important;
    }
  </style>
</head>
<body class="bg-[#e8dccc] min-h-screen">
  <header class="bg-red-700 text-white shadow-lg sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 py-3 flex justify-between items-center">
      <a href="/" class="flex items-center space-x-2">
        <span class="text-3xl">🍕</span>
        <h1 class="text-2xl font-bold font-serif">Bella Napoli</h1>
      </a>
      <div class="flex items-center space-x-4">
        <span>Hola, <%= currentUser.name %></span>
        <a href="/logout" class="bg-white text-red-700 px-4 py-2 rounded-full font-semibold hover:bg-red-50 transition">Salir</a>
      </div>
    </div>
  </header>

  <main class="max-w-4xl mx-auto px-4 py-8">
    <h2 class="text-4xl font-bold font-serif text-center mb-8 text-stone-800">Arma tu pedido</h2>

    <form action="/order" method="POST" id="orderForm">
      <%- include('csrf') %>

      <!-- Paso 1: Pizzas -->
      <section id="step-1" class="step">
        <h3 class="text-2xl font-bold font-serif mb-6 text-stone-800">🍕 Elige tus pizzas</h3>
        <% pizzas.forEach((pizza, idx) => { %>
          <div class="bg-[#f5efe6] rounded-2xl shadow-md hover:shadow-lg transition-all mb-4 overflow-hidden border border-stone-100">
            <div class="p-5 flex items-center justify-between cursor-pointer select-none" onclick="this.parentElement.querySelector('.pizza-check').click()">
              <div class="flex items-center space-x-4">
                <input type="checkbox" name="pizzas[<%= idx %>][selected]" value="1"
                    class="appearance-none h-6 w-6 rounded border-2 border-stone-300 bg-white cursor-pointer transition-all duration-200 ease-in-out
                            hover:border-red-600 hover:bg-red-50
                            focus:outline-none focus:ring-4 focus:ring-red-300 focus:ring-offset-0
                            checked:bg-red-600 checked:border-red-600 checked:hover:bg-red-700 checked:hover:border-red-700
                            pizza-check custom-checkbox"
                    onclick="event.stopPropagation()">
                <div>
                  <h3 class="text-xl font-semibold text-stone-800"><%= pizza.name %></h3>
                  <p class="text-sm text-stone-500"><%= pizza.description %></p>
                </div>
              </div>
              <span class="text-stone-400 font-medium">
                <% if (prices[pizza.id]) { %>
                  Desde $<%= Math.min(...Object.values(prices[pizza.id])).toFixed(2) %>
                <% } %>
              </span>
            </div>
            <div class="pizza-options hidden border-t border-stone-100 bg-stone-50 px-5 py-4" id="options-<%= idx %>">
              <div class="grid grid-cols-2 gap-4">
                <label class="block">
                  <span class="text-sm font-medium text-stone-600">Tamaño</span>
                  <select name="pizzas[<%= idx %>][size]" class="size-select mt-1 block w-full rounded-lg border-stone-200 shadow-sm">
                    <% sizes.forEach(size => { %>
                      <option value="<%= size.id %>"><%= size.label %></option>
                    <% }) %>
                  </select>
                </label>
                <label class="block">
                  <span class="text-sm font-medium text-stone-600">Cantidad</span>
                  <input type="number" name="pizzas[<%= idx %>][quantity]" 
                         min="1" max="30" value="1" 
                         onkeydown="return false;" 
                         class="border rounded p-1 w-16 ml-2 quantity-input">
                </label>
              </div>
              <div class="mt-4">
                <span class="text-sm font-medium text-stone-600">Ingredientes extra</span>
                <div class="grid grid-cols-2 md:grid-cols-4 gap-2 mt-2">
                  <% toppings.forEach(topping => { %>
                    <label class="flex items-center space-x-2 bg-white p-2 rounded-lg border border-stone-200 hover:border-red-300 transition cursor-pointer">
                      <input type="checkbox" name="pizzas[<%= idx %>][toppings][]" value="<%= topping.id %>"
                             class="topping-check form-checkbox h-4 w-4 text-red-600 rounded">
                      <span class="text-sm"><%= topping.name %> (+$<%= topping.extra_price.toFixed(2) %>)</span>
                    </label>
                  <% }) %>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
        <button type="button" onclick="nextStep(2)" class="w-full bg-red-700 hover:bg-red-800 text-white font-bold text-lg py-4 rounded-2xl shadow-xl hover:shadow-2xl transform hover:-translate-y-0.5 transition">
          Siguiente →
        </button>
      </section>

      <!-- Paso 2: Pregunta por bebidas -->
      <section id="step-2" class="step hidden">
        <h3 class="text-2xl font-bold font-serif mb-6 text-stone-800">¿Deseas agregar bebidas o acompañantes?</h3>
        <div class="flex gap-4">
          <button type="button" onclick="chooseBebidas(true)" class="bg-red-700 hover:bg-red-800 text-white font-bold py-3 px-8 rounded-full transition">Sí, quiero bebidas</button>
          <button type="button" onclick="chooseBebidas(false)" class="bg-stone-200 hover:bg-stone-300 text-stone-700 font-bold py-3 px-8 rounded-full transition">No, gracias</button>
        </div>
        <button type="button" onclick="prevStep(1)" class="mt-6 text-stone-500 hover:text-stone-700 transition">← Atrás</button>
      </section>

      <!-- Paso 3: Bebidas (si eligió sí) -->
      <section id="step-3" class="step hidden">
        <h3 class="text-2xl font-bold font-serif mb-6 text-stone-800">🥤 Bebidas</h3>
        <% bebidas.forEach(bebida => { %>
          <div class="bg-[#f5efe6] rounded-2xl shadow-md hover:shadow-lg transition-all mb-4 p-5 flex items-center justify-between border border-stone-100">
            <div class="flex items-center space-x-4">
              <span class="text-3xl">🥤</span>
              <div>
                <h3 class="text-xl font-semibold text-stone-800"><%= bebida.name %></h3>
                <p class="text-sm text-stone-500">$<%= bebida.price.toFixed(2) %></p>
              </div>
            </div>
            <div class="flex items-center space-x-2">
              <label class="text-sm font-medium text-stone-600">Cantidad</label>
              <input type="number" name="bebidas[<%= bebida.id %>]" min="0" max="30" value="0" 
                     onkeydown="return false;" 
                     class="bebida-qty border rounded p-1 w-16 quantity-input">
            </div>
          </div>
        <% }) %>
        <button type="button" onclick="nextStep(4)" class="w-full bg-red-700 hover:bg-red-800 text-white font-bold text-lg py-4 rounded-2xl shadow-xl hover:shadow-2xl transform hover:-translate-y-0.5 transition">
          Siguiente →
        </button>
        <button type="button" onclick="prevStep(2)" class="mt-4 text-stone-500 hover:text-stone-700 transition">← Atrás</button>
      </section>

      <!-- Paso 4: Datos de contacto -->
      <section id="step-4" class="step hidden">
        <div class="bg-[#f5efe6] rounded-2xl shadow-md p-6 mb-6">
          <h3 class="text-2xl font-bold font-serif mb-6 text-stone-800">Datos de contacto</h3>
          <div class="grid md:grid-cols-2 gap-6">
            <label class="block">
              <span class="text-sm font-medium text-stone-600">Teléfono</span>
              <input type="tel" name="phone" id="phoneInput" required 
                     placeholder="0000-0000000" maxlength="12"
                     pattern="^\d{4}-\d{7}$" 
                     class="mt-1 block w-full rounded-lg border-stone-200 shadow-sm">
              <span id="phoneError" class="text-red-500 text-sm hidden mt-1">⛔ Código de área inexistente</span>
            </label>
            <label class="block">Hora de recogida:
              <input type="time" name="pickup_time" id="pickupTime" required
              min="17:00" max="23:59"
              class="border rounded p-2 w-full">
              <span id="timeError" class="text-red-500 text-sm hidden mt-1">⛔ El horario de recogida es de 5:00 PM a 11:59 PM</span>
            </label>
            <label class="block md:col-span-2">
              <span class="text-sm font-medium text-stone-600">Método de pago</span>
              <select name="payment_method" id="paymentMethod" required 
                      class="mt-1 block w-full rounded-lg border-stone-200 shadow-sm">
                <option value="">Selecciona...</option>
                <option value="Efectivo en local">Efectivo en local</option>
                <option value="Pago móvil">Pago móvil</option>
                <option value="Transferencia bancaria">Transferencia bancaria</option>
                <option value="Binance">Binance</option>
                <option value="Zelle">Zelle</option>
              </select>
            </label>
          </div>
        </div>

        <div id="orderSummary" class="bg-[#f5efe6] rounded-2xl shadow-md p-6 mb-6 hidden border-l-4 border-red-600">
          <h3 class="text-xl font-bold font-serif mb-4">Tu pedido</h3>
          <ul id="summaryList" class="space-y-2"></ul>
          <div class="flex justify-between items-center mt-4 pt-4 border-t">
            <span class="text-lg font-bold">Total</span>
            <span class="text-2xl font-bold text-red-600">$<span id="totalPrice">0.00</span></span>
          </div>
        </div>

        <button type="submit" id="submitOrderBtn" class="w-full bg-red-700 hover:bg-red-800 text-white font-bold text-lg py-4 rounded-2xl shadow-xl hover:shadow-2xl transform hover:-translate-y-0.5 transition">
          Enviar pedido 🍕
        </button>
        <button type="button" onclick="prevStep(3)" class="mt-4 text-stone-500 hover:text-stone-700 transition">← Atrás</button>
      </section>
    </form>
  </main>

  <!-- Datos del servidor para JavaScript -->
  <script id="prices-data" type="application/json"><%- JSON.stringify(prices) %></script>
  <script id="toppings-data" type="application/json"><%- JSON.stringify(toppings) %></script>
  <script id="names-data" type="application/json"><%- JSON.stringify(pizzas.map(p => p.name)) %></script>
  <script id="bebidas-data" type="application/json"><%- JSON.stringify(bebidas) %></script>

  <script>
    const pizzaPrices = JSON.parse(document.getElementById('prices-data').textContent);
    const toppingsList = JSON.parse(document.getElementById('toppings-data').textContent);
    const pizzaNames = JSON.parse(document.getElementById('names-data').textContent);
    const checkboxes = document.querySelectorAll('.pizza-check');
    const orderSummary = document.getElementById('orderSummary');
    const summaryList = document.getElementById('summaryList');
    const totalSpan = document.getElementById('totalPrice');
    const bebidasList = JSON.parse(document.getElementById('bebidas-data').textContent);

    // Control de pasos
    let currentStep = 1;
    let wantsBebidas = false;

    function showStep(step) {
      document.querySelectorAll('.step').forEach(s => s.classList.add('hidden'));
      document.getElementById('step-' + step).classList.remove('hidden');
      currentStep = step;
    }

    function nextStep(step) {
      showStep(step);
    }

    function prevStep(step) {
      if (currentStep === 4 && !wantsBebidas) {
        showStep(2);
      } else {
        showStep(step);
      }
    }

    function chooseBebidas(wants) {
      wantsBebidas = wants;
      if (wants) {
        showStep(3);
      } else {
        showStep(4);
      }
    }

    function updateSummary() {
      let total = 0;
      summaryList.innerHTML = '';

      checkboxes.forEach(cb => {
        if (cb.checked) {
          const idxMatch = cb.name.match(/\[(\d+)\]/);
          if (!idxMatch) return;
          const idx = parseInt(idxMatch[1]);
          const pizzaId = idx + 1;

          const optionsDiv = document.getElementById(`options-${idx}`);
          const sizeSelect = optionsDiv.querySelector('.size-select');
          const sizeId = sizeSelect.value;
          const qtyInput = optionsDiv.querySelector('.quantity-input');
          const quantity = parseInt(qtyInput.value) || 1;

          const pizzaName = pizzaNames[idx];

          let basePrice = 0;
          if (pizzaPrices[pizzaId] && pizzaPrices[pizzaId][sizeId]) {
            basePrice = pizzaPrices[pizzaId][sizeId];
          }

          const toppingChecks = optionsDiv.querySelectorAll('.topping-check:checked');
          let extrasCost = 0;
          const selectedToppings = [];
          toppingChecks.forEach(tc => {
            const toppingId = parseInt(tc.value);
            const topping = toppingsList.find(t => t.id === toppingId);
            if (topping) {
              extrasCost += topping.extra_price;
              selectedToppings.push(topping.name);
            }
          });

          const lineTotal = (basePrice + extrasCost) * quantity;
          total += lineTotal;

          const li = document.createElement('li');
          let text = `${quantity}x ${pizzaName} (${sizeSelect.options[sizeSelect.selectedIndex].text})`;
          if (selectedToppings.length) {
            text += ` + ${selectedToppings.join(', ')}`;
          }
          text += ` = $${lineTotal.toFixed(2)}`;
          li.textContent = text;
          summaryList.appendChild(li);
        }
      });

      document.querySelectorAll('.bebida-qty').forEach(input => {
        const qty = parseInt(input.value) || 0;
        if (qty > 0) {
          const bebidaId = input.name.match(/\[(\d+)\]/)[1];
          const bebida = bebidasList.find(b => b.id == bebidaId);
          if (bebida) {
            const lineTotal = bebida.price * qty;
            total += lineTotal;

            const li = document.createElement('li');
            li.textContent = `${qty}x ${bebida.name} = $${lineTotal.toFixed(2)}`;
            summaryList.appendChild(li);
          }
        }
      });

      totalSpan.textContent = total.toFixed(2);
      orderSummary.classList.toggle('hidden', total === 0);
    }

    checkboxes.forEach(cb => {
      cb.addEventListener('change', function() {
        const idx = Array.from(checkboxes).indexOf(this);
        const optionsDiv = document.getElementById(`options-${idx}`);
        optionsDiv.classList.toggle('hidden', !this.checked);
        if (!this.checked) {
          optionsDiv.querySelectorAll('.topping-check').forEach(t => t.checked = false);
          optionsDiv.querySelector('.quantity-input').value = 1;
        }
        updateSummary();
        this.classList.add('animate-pop');
        setTimeout(() => this.classList.remove('animate-pop'), 300);
        this.classList.add('no-hover');
        setTimeout(() => this.classList.remove('no-hover'), 150);
      });
    });

    document.querySelectorAll('.size-select, .quantity-input, .topping-check, .bebida-qty').forEach(el => {
      el.addEventListener('change', updateSummary);
    });

    // Validación de teléfono
    const validAreaCodes = ['0412', '0414', '0416', '0422', '0424', '0426'];
    const phoneInput = document.getElementById('phoneInput');
    const phoneError = document.getElementById('phoneError');

    function validateAreaCode(value) {
      const cleaned = value.replace(/\D/g, '');
      if (cleaned.length < 4) return true;
      const code = cleaned.substring(0, 4);
      return validAreaCodes.includes(code);
    }

    function updatePhoneUI() {
      const val = phoneInput.value;
      if (val.replace(/\D/g, '').length < 4) {
        phoneError.classList.add('hidden');
        phoneInput.classList.remove('border-red-500');
        return;
      }
      if (!validateAreaCode(val)) {
        phoneError.classList.remove('hidden');
        phoneInput.classList.add('border-red-500');
      } else {
        phoneError.classList.add('hidden');
        phoneInput.classList.remove('border-red-500');
      }
    }

    phoneInput.addEventListener('keydown', function(e) {
      if (e.key === 'Backspace') {
        const value = this.value;
        const cursorPos = this.selectionStart;
        if (value.charAt(4) === '-' && cursorPos === 5) {
          e.preventDefault();
          const newValue = value.substring(0, 3) + value.substring(4);
          this.value = newValue;
          this.setSelectionRange(3, 3);
          this.dispatchEvent(new Event('input'));
        }
      }
    });

    phoneInput.addEventListener('input', function(e) {
      let value = this.value.replace(/\D/g, '');
      if (value.length >= 4) {
        value = value.substring(0,4) + '-' + value.substring(4,11);
      }
      this.value = value;
      updatePhoneUI();
    });

    phoneInput.addEventListener('paste', function(e) {
      e.preventDefault();
      const cleaned = (e.clipboardData || window.clipboardData).getData('text').replace(/\D/g, '');
      let formatted = cleaned.substring(0,4);
      if (cleaned.length > 4) formatted += '-' + cleaned.substring(4,11);
      this.value = formatted;
      updatePhoneUI();
    });

    document.getElementById('orderForm').addEventListener('submit', function(e) {
      if (!validateAreaCode(phoneInput.value)) {
        e.preventDefault();
        phoneError.classList.remove('hidden');
        phoneInput.classList.add('border-red-500');
        phoneInput.focus();
      }
    });

    // Validación de hora
    const pickupTimeInput = document.getElementById('pickupTime');
    const timeError = document.getElementById('timeError');

    function validatePickupTime() {
      const value = pickupTimeInput.value;
      if (!value) {
        timeError.classList.add('hidden');
        pickupTimeInput.classList.remove('border-red-500');
        return true;
      }

      const [hours, minutes] = value.split(':').map(Number);
      const totalMinutes = hours * 60 + minutes;

      if (totalMinutes < 17 * 60 || totalMinutes > 23 * 60 + 59) {
        timeError.classList.remove('hidden');
        pickupTimeInput.classList.add('border-red-500');
        return false;
      } else {
        timeError.classList.add('hidden');
        pickupTimeInput.classList.remove('border-red-500');
        return true;
      }
    }

    pickupTimeInput.addEventListener('input', validatePickupTime);
    pickupTimeInput.addEventListener('change', validatePickupTime);

    document.getElementById('orderForm').addEventListener('submit', function(e) {
      if (!validatePickupTime()) {
        e.preventDefault();
        pickupTimeInput.focus();
      }
    });

    // Botón dinámico de pago
    const paymentMethodSelect = document.getElementById('paymentMethod');
    const submitBtn = document.getElementById('submitOrderBtn');

    function updateButtonText() {
      const method = paymentMethodSelect.value;
      if (method === 'Efectivo en local') {
        submitBtn.textContent = 'Enviar pedido 🍕';
      } else {
        submitBtn.textContent = 'Realizar pago 💳';
      }
    }

    paymentMethodSelect.addEventListener('change', updateButtonText);
    updateButtonText();

    updatePhoneUI();
    updateSummary();
  </script>

</body>
</html>