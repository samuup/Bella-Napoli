<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Bebidas - Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; }
    h1, h2, h3, .font-serif { font-family: 'Playfair Display', serif; }
  </style>
</head>
<body class="bg-stone-50 flex">
  <%- include('admin-sidebar') %>
  <div class="ml-64 p-8 flex-1">
    <div class="flex justify-between items-center mb-8">
      <h1 class="text-4xl font-bold font-serif text-stone-800">🥤 Bebidas</h1>
    </div>

    <% if (success_msg && success_msg.length > 0) { %>
      <div class="bg-green-100 border border-green-300 text-green-800 px-4 py-3 rounded-2xl mb-6"><%= success_msg[0] %></div>
    <% } %>
    
    <% if (error_msg && error_msg.length > 0) { %>
      <div class="bg-red-100 border border-red-300 text-red-800 px-4 py-3 rounded-2xl mb-6"><%= error_msg[0] %></div>
    <% } %>

    <!-- Formulario de nueva bebida -->
    <form action="/admin/bebidas/add" method="POST" id="bebidaForm" class="bg-white rounded-2xl shadow-md p-6 mb-8 max-w-md">
      <%- include('csrf') %>
      <h2 class="text-xl font-bold font-serif mb-4">Nueva bebida</h2>
      <label class="block mb-3">
        <span class="text-stone-700 font-medium">Nombre</span>
        <input type="text" name="name" id="bebidaName" required pattern="^[A-Za-záéíóúüñÁÉÍÓÚÜÑ\s]+$" title="Solo letras y espacios"
               class="mt-1 block w-full border border-stone-300 rounded-xl p-3 focus:ring-2 focus:ring-red-500 focus:border-red-500 transition">
        <p id="bebidaNameError" class="text-red-500 text-xs mt-1 hidden">Solo letras y espacios permitidos.</p>
      </label>
      <label class="block mb-4">
        <span class="text-stone-700 font-medium">Precio</span>
        <div class="relative mt-1">
          <span class="absolute inset-y-0 left-3 flex items-center text-stone-500">$</span>
          <input type="number" name="price" id="bebidaPrice" required min="0" step="0.01"
                 class="block w-full pl-8 pr-4 py-3 h-12 border border-stone-300 rounded-xl focus:ring-2 focus:ring-red-500 focus:border-red-500 transition">
        </div>
        <p id="bebidaPriceError" class="text-red-500 text-xs mt-1 hidden">Precio debe ser ≥ 0.</p>
      </label>
      <button type="submit" class="bg-red-700 hover:bg-red-800 text-white font-bold py-2 px-6 rounded-full transition">Agregar</button>
    </form>

    <!-- Listado de bebidas -->
    <div class="grid md:grid-cols-3 gap-4">
      <% bebidas.forEach(bebida => { %>
        <div class="bg-white rounded-xl shadow-md p-5 flex items-center justify-between">
          <div>
            <h3 class="font-semibold text-stone-800"><%= bebida.name %></h3>
            <p class="text-sm text-stone-500">$<%= bebida.price.toFixed(2) %></p>
          </div>
          <div class="flex space-x-2">
            <a href="/admin/bebidas/edit/<%= bebida.id %>" class="text-blue-600 hover:bg-blue-50 p-2 rounded-lg transition" title="Editar">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
            </a>
            <button onclick="openConfirmModal('¿Eliminar <%= bebida.name %>?', '/admin/bebidas/delete/<%= bebida.id %>')" class="text-red-600 hover:bg-red-50 p-2 rounded-lg transition" title="Eliminar">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
            </button>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
  <%- include('modal-confirm') %>

  <script>
    const nameInput = document.getElementById('bebidaName');
    const priceInput = document.getElementById('bebidaPrice');
    const nameError = document.getElementById('bebidaNameError');
    const priceError = document.getElementById('bebidaPriceError');

    function validateName() {
      const value = nameInput.value.trim();
      const regex = /^[A-Za-záéíóúüñÁÉÍÓÚÜÑ\s]+$/;
      if (value.length > 0 && !regex.test(value)) {
        nameError.classList.remove('hidden');
        nameInput.classList.add('border-red-500');
        return false;
      } else {
        nameError.classList.add('hidden');
        nameInput.classList.remove('border-red-500');
        return true;
      }
    }

    function validatePrice() {
      const price = parseFloat(priceInput.value);
      if (isNaN(price) || price < 0) {
        priceError.classList.remove('hidden');
        priceInput.classList.add('border-red-500');
        return false;
      } else {
        priceError.classList.add('hidden');
        priceInput.classList.remove('border-red-500');
        return true;
      }
    }

    nameInput.addEventListener('blur', validateName);
    nameInput.addEventListener('input', () => { if (validateName()) { nameError.classList.add('hidden'); nameInput.classList.remove('border-red-500'); } });
    priceInput.addEventListener('blur', validatePrice);
    priceInput.addEventListener('input', () => { if (validatePrice()) { priceError.classList.add('hidden'); priceInput.classList.remove('border-red-500'); } });

    priceInput.addEventListener('keydown', function(e) {
      const allowed = ['Backspace','Delete','ArrowLeft','ArrowRight','Tab','Escape','Home','End'];
      if (allowed.includes(e.key)) return;
      if (e.key === '.' && !this.value.includes('.')) return;
      if (!/^\d$/.test(e.key)) e.preventDefault();
    });

    priceInput.addEventListener('paste', function(e) {
      e.preventDefault();
      const pasted = (e.clipboardData || window.clipboardData).getData('text');
      let cleaned = pasted.replace(/[^0-9.]/g, '');
      const parts = cleaned.split('.');
      if (parts.length > 1) cleaned = parts[0] + '.' + parts.slice(1).join('');
      const num = parseFloat(cleaned);
      if (!isNaN(num) && num >= 0) this.value = num;
      else this.value = '';
      validatePrice();
    });

    document.getElementById('bebidaForm').addEventListener('submit', function(e) {
      if (!validateName() || !validatePrice()) {
        e.preventDefault();
        if (!validateName()) nameInput.focus(); else priceInput.focus();
      }
    });
  </script>
</body>
</html>