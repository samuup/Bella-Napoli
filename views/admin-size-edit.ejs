<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Editar Tamaño - Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; }
    h1, h2, h3, .font-serif { font-family: 'Playfair Display', serif; }
  </style>
</head>
<body class="bg-[#e8dccc] flex">
  <%- include('admin-sidebar') %>
  <div class="ml-64 p-8 flex-1">
    <h1 class="text-4xl font-bold font-serif text-stone-800 mb-8">Editar Tamaño</h1>

    <% if (error_msg && error_msg.length > 0) { %>
      <div class="bg-red-100 border border-red-300 text-red-800 px-4 py-3 rounded-2xl mb-6">
        <%= error_msg[0] %>
      </div>
    <% } %>

    <form action="/admin/sizes/edit/<%= size.id %>" method="POST" class="bg-[#f5efe6] rounded-2xl shadow-md p-6 max-w-md">
      <%- include('csrf') %>
      <label class="block mb-4">
        <span class="text-stone-700 font-medium">Etiqueta</span>
        <input type="text" name="label" id="editSizeLabel" required 
          value="<%= size.label %>"
          pattern="^[A-Za-záéíóúüñÁÉÍÓÚÜÑ\s]+$"
          title="Solo letras y espacios"
          class="... (tus clases existentes) ...">
          <p id="editSizeLabelError" class="text-red-500 text-xs mt-1 hidden">Solo letras y espacios permitidos.</p>
      </label>
      <div class="flex space-x-4">
        <button type="submit" class="bg-red-700 text-white font-bold py-2 px-6 rounded-full hover:bg-red-800 hover:shadow-lg transition">Guardar</button>
        <a href="/admin/sizes" class="bg-stone-200 text-stone-700 font-medium py-2 px-6 rounded-full hover:bg-stone-300 transition">Cancelar</a>
      </div>
    </form>
  </div>

  <script>
    const editSizeLabelInput = document.getElementById('editSizeLabel');
    const editSizeLabelError = document.getElementById('editSizeLabelError');

    function validateEditSizeLabel() {
      const value = editSizeLabelInput.value.trim();
      const regex = /^[A-Za-záéíóúüñÁÉÍÓÚÜÑ\s]+$/;
      if (value.length > 0 && !regex.test(value)) {
        editSizeLabelError.classList.remove('hidden');
        editSizeLabelInput.classList.add('border-red-500');
        return false;
      } else {
        editSizeLabelError.classList.add('hidden');
        editSizeLabelInput.classList.remove('border-red-500');
        return true;
      }
    }

    editSizeLabelInput.addEventListener('blur', validateEditSizeLabel);
    editSizeLabelInput.addEventListener('input', function() {
      if (validateEditSizeLabel()) {
        editSizeLabelError.classList.add('hidden');
        editSizeLabelInput.classList.remove('border-red-500');
      }
    });

    document.querySelector('form').addEventListener('submit', function(e) {
      if (!validateEditSizeLabel()) {
        e.preventDefault();
        editSizeLabelInput.focus();
      }
    });
  </script>

</body>
</html>