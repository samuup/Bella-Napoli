<!-- ============================================================
  VIEW: admin-size-edit.ejs — Editar tamaño (admin)
  ------------------------------------------------------------
  Variables: size.
============================================================ -->
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <%- include('partials/head', { title: 'Editar Tamaño - Admin' }) %>
</head>
<body class="bg-background text-on-surface flex">
  <%- include('admin-sidebar') %>
  <div class="ml-64 p-8 flex-1">
    <h1 class="text-4xl font-bold font-display text-on-surface mb-8">Editar Tamaño</h1>

    <% if (error_msg && error_msg.length > 0) { %>
      <div class="bg-brand-red/10 border border-brand-red/40 text-red-300 px-4 py-3 rounded-none mb-6">
        <%= error_msg[0] %>
      </div>
    <% } %>

    <form action="/admin/sizes/edit/<%= size.id %>" method="POST" class="bg-surface-container border border-outline-variant rounded-none shadow-md p-6 max-w-md">
      <%- include('csrf') %>
      <label class="block mb-4">
        <span class="text-on-surface font-medium">Etiqueta</span>
        <input type="text" name="label" id="editSizeLabel" required 
          value="<%= size.label %>"
          pattern="^[A-Za-záéíóúüñÁÉÍÓÚÜÑ\s]+$"
          title="Solo letras y espacios"
          class="mt-1 block w-full bg-surface-container border border-outline-variant text-on-surface rounded-none p-3 focus:ring-2 focus:ring-brand-red focus:border-brand-red transition placeholder:text-on-surface-variant/60">
          <p id="editSizeLabelError" class="text-brand-red text-xs mt-1 hidden">Solo letras y espacios permitidos.</p>
      </label>
      <div class="flex space-x-4">
        <button type="submit" class="bg-brand-red text-white font-bold py-2 px-6 rounded-none hover:bg-red-800 hover:shadow-lg transition">Guardar</button>
        <a href="/admin/sizes" class="bg-surface-container-high text-on-surface font-medium py-2 px-6 rounded-none hover:bg-surface-container-highest transition">Cancelar</a>
      </div>
    </form>
  </div>

  <script>
    const editSizeLabelInput = document.getElementById('editSizeLabel');
    const editSizeLabelError = document.getElementById('editSizeLabelError');

    function validateEditSizeLabel() {
      const value = editSizeLabelInput.value.trim();
      const regex = /^[A-Za-záéíóúüñÁÉÍÓÚÜÑ\s]+$/;
      if (value.length > 0 && !regex.test(value)) {
        editSizeLabelError.classList.remove('hidden');
        editSizeLabelInput.classList.add('border-red-500');
        return false;
      } else {
        editSizeLabelError.classList.add('hidden');
        editSizeLabelInput.classList.remove('border-red-500');
        return true;
      }
    }

    editSizeLabelInput.addEventListener('blur', validateEditSizeLabel);
    editSizeLabelInput.addEventListener('input', function() {
      if (validateEditSizeLabel()) {
        editSizeLabelError.classList.add('hidden');
        editSizeLabelInput.classList.remove('border-red-500');
      }
    });

    document.querySelector('form').addEventListener('submit', function(e) {
      if (!validateEditSizeLabel()) {
        e.preventDefault();
        editSizeLabelInput.focus();
      }
    });
  </script>

</body>
</html>