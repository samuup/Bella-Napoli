<!-- ============================================================
  VIEW: admin-sizes.ejs — Administración de tamaños (listado)
  ------------------------------------------------------------
  Variables: sizes.
============================================================ -->
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <%- include('partials/head', { title: 'Tamaños - Admin' }) %>
</head>
<body class="bg-background text-on-surface flex">
  <%- include('admin-sidebar') %>
  <div class="ml-64 p-8 flex-1">
    <div class="flex justify-between items-center mb-8">
      <h1 class="text-4xl font-bold font-display text-on-surface">📏 Tamaños</h1>
    </div>

    <% if (success_msg && success_msg.length > 0) { %>
      <div class="bg-brand-green/10 border border-brand-green/40 text-green-300 px-4 py-3 rounded-none mb-6"><%= success_msg[0] %></div>
    <% } %>
    
    <% if (error_msg && error_msg.length > 0) { %>
      <div class="bg-brand-red/10 border border-brand-red/40 text-red-300 px-4 py-3 rounded-none mb-6"><%= error_msg[0] %></div>
    <% } %>

    <!-- Formulario para agregar tamaño -->
    <form action="/admin/sizes/add" method="POST" id="sizeForm" class="bg-surface-container border border-outline-variant rounded-none shadow-md p-6 mb-8 max-w-md">
      <%- include('csrf') %>
      <h2 class="text-xl font-bold font-display mb-4">Nuevo tamaño</h2>
      <label class="block mb-4">
        <span class="text-on-surface font-medium">Etiqueta</span>
        <input type="text" name="label" id="sizeLabel" required pattern="^[A-Za-záéíóúüñÁÉÍÓÚÜÑ\s]+$" title="Solo letras y espacios"
               class="mt-1 block w-full bg-surface-container border border-outline-variant text-on-surface rounded-none p-3 focus:ring-2 focus:ring-brand-red focus:border-brand-red transition placeholder:text-on-surface-variant/60">
        <p id="sizeLabelError" class="text-brand-red text-xs mt-1 hidden">Solo letras y espacios permitidos.</p>
      </label>
      <button type="submit" class="bg-brand-red hover:bg-red-800 text-white font-bold py-2 px-6 rounded-none transition">Agregar</button>
    </form>

    <!-- Listado de tamaños -->
    <div class="grid md:grid-cols-3 gap-4">
      <% sizes.forEach(size => { %>
        <div class="bg-surface-container border border-outline-variant rounded-none shadow-md p-5 flex items-center justify-between">
          <span class="text-xl font-semibold text-on-surface"><%= size.label %></span>
          <div class="flex space-x-2">
            <a href="/admin/sizes/edit/<%= size.id %>" class="text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface p-2 rounded-none transition" title="Editar">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
            </a>
            <button onclick="openConfirmModal('¿Eliminar el tamaño <%= size.label %>?', '/admin/sizes/delete/<%= size.id %>')" class="text-brand-red hover:bg-surface-container-high p-2 rounded-none transition" title="Eliminar">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
            </button>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
  <%- include('modal-confirm') %>

  <script>
    // Validación para el nuevo tamaño
    const sizeLabelInput = document.getElementById('sizeLabel');
    const sizeLabelError = document.getElementById('sizeLabelError');

    function validateSizeLabel() {
      const value = sizeLabelInput.value.trim();
      const regex = /^[A-Za-záéíóúüñÁÉÍÓÚÜÑ\s]+$/;
      if (value.length > 0 && !regex.test(value)) {
        sizeLabelError.classList.remove('hidden');
        sizeLabelInput.classList.add('border-red-500');
        return false;
      } else {
        sizeLabelError.classList.add('hidden');
        sizeLabelInput.classList.remove('border-red-500');
        return true;
      }
    }

    sizeLabelInput.addEventListener('blur', validateSizeLabel);
    sizeLabelInput.addEventListener('input', function() {
      if (validateSizeLabel()) {
        sizeLabelError.classList.add('hidden');
        sizeLabelInput.classList.remove('border-red-500');
      }
    });

    document.getElementById('sizeForm').addEventListener('submit', function(e) {
      if (!validateSizeLabel()) {
        e.preventDefault();
        sizeLabelInput.focus();
      }
    });
  </script>
</body>
</html>