<!-- ============================================================
  VIEW: login.ejs — Formulario de inicio de sesión
  ------------------------------------------------------------
  Variables: error (mensaje de error opcional).
============================================================ -->
<!DOCTYPE html>
<html lang="es" class="dark">
<head>
  <%- include('partials/head', { title: 'Iniciar sesión — Bella Napoli' }) %>
  <style>
    @keyframes shake {
      0% { transform: translateX(0); }
      25% { transform: translateX(-4px); }
      50% { transform: translateX(4px); }
      75% { transform: translateX(-4px); }
      100% { transform: translateX(0); }
    }
    .shake { animation: shake 0.3s ease-in-out; }
    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .fade-in-up { animation: fadeInUp 0.6s ease-out; }
    .fl-input {
      background-color: transparent !important;
      border: 0;
      border-bottom: 1px solid #fff5e6;
      color: #fff5e6;
      -webkit-text-fill-color: #fff5e6;
      caret-color: #fff5e6;
      width: 100%;
      padding: 0.5rem 0;
      font-family: 'Manrope', sans-serif;
    }
    .fl-input:focus { outline: none; border-color: #d32f2f; }
    .fl-input::placeholder { color: #8e9192; }
    input:-webkit-autofill,
    input:-webkit-autofill:hover,
    input:-webkit-autofill:focus {
      -webkit-text-fill-color: #fff5e6;
      -webkit-box-shadow: 0 0 0 1000px #2e2920 inset;
      caret-color: #fff5e6;
      transition: background-color 9999s ease-in-out 0s;
    }
  </style>
</head>
<body class="bg-background text-on-background min-h-screen flex items-center justify-center p-4 relative overflow-x-hidden font-sans">
  <div class="texture-overlay"></div>
  <div class="w-full max-w-md fade-in-up">
    <div class="bg-surface-container-high border border-outline-variant ambient-shadow overflow-hidden border-t-4 border-t-brand-red">
      <div class="p-8 md:p-10">
        <div class="text-center mb-6">
          <a href="/" class="inline-flex items-center justify-center space-x-2 mb-4">
            <span class="text-5xl">🍕</span>
          </a>
          <h1 class="font-display text-headline-lg text-brand-cream">Bella Napoli</h1>
          <p class="font-sans text-body-md text-on-surface-variant mt-1">Inicia sesión para continuar</p>
          <div class="flex justify-center mt-4">
            <div class="w-16 h-0.5 bg-brand-red"></div>
          </div>
        </div>

        <% if (error) { %>
          <div class="bg-red-900/40 border border-brand-red text-brand-cream px-4 py-3 mb-6 font-sans text-body-md">
            <%= error %>
          </div>
        <% } %>

        <form action="/login" method="POST" id="loginForm" class="space-y-5">
          <%- include('csrf') %>
          <!-- Correo -->
          <div>
            <label class="block font-label-caps text-label-caps text-on-surface-variant uppercase tracking-widest mb-1">Correo electrónico</label>
            <input type="email" name="email" id="emailInput" required
                   class="fl-input mt-1"
                   placeholder="tu@correo.com">
            <p id="emailError" class="text-brand-red font-sans text-sm mt-1 hidden"></p>
          </div>
          <!-- Contraseña -->
          <div>
            <label class="block font-label-caps text-label-caps text-on-surface-variant uppercase tracking-widest mb-1">Contraseña</label>
            <div class="relative">
              <input type="password" name="password" id="passwordInput" required
                     class="fl-input pr-12"
                     placeholder="••••••••">
              <button type="button" id="togglePassword"
                      class="absolute inset-y-0 right-0 pr-3 flex items-center text-on-surface-variant hover:text-brand-cream transition"
                      aria-label="Mostrar contraseña">
                <svg id="eyeOpen" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
                <svg id="eyeClosed" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" />
                </svg>
              </button>
            </div>
            <p id="passwordError" class="text-brand-red font-sans text-sm mt-1 hidden"></p>
          </div>
          <button type="submit" id="submitBtn"
                  class="w-full bg-brand-red hover:bg-red-800 text-brand-cream font-label-caps text-label-caps py-3 rounded-none transition active:scale-[0.99] disabled:opacity-50 disabled:cursor-not-allowed">
            Entrar
          </button>
        </form>

        <p class="text-center font-sans text-body-md text-on-surface-variant mt-6">
          ¿No tienes cuenta? 
          <a href="/register" class="text-brand-red hover:text-red-400 font-medium underline underline-offset-2">Regístrate aquí</a>
        </p>
        <p class="text-center font-sans text-body-md text-on-surface-variant mt-4">
          <a href="/forgot-password" class="text-brand-red hover:underline">¿Olvidaste tu contraseña?</a>
        </p>
      </div>
    </div>

    <p class="text-center font-sans text-body-md text-on-surface-variant opacity-70 mt-6">
      <a href="/" class="hover:text-brand-cream transition">← Volver al menú</a>
    </p>
  </div>

  <script>
    const emailInput = document.getElementById('emailInput');
    const emailError = document.getElementById('emailError');
    const passwordInput = document.getElementById('passwordInput');
    const passwordError = document.getElementById('passwordError');
    const togglePassword = document.getElementById('togglePassword');
    const eyeOpen = document.getElementById('eyeOpen');
    const eyeClosed = document.getElementById('eyeClosed');
    const submitBtn = document.getElementById('submitBtn');
    const form = document.getElementById('loginForm');

    // Mostrar/ocultar contraseña
    togglePassword.addEventListener('click', () => {
      const isPassword = passwordInput.type === 'password';
      passwordInput.type = isPassword ? 'text' : 'password';
      eyeOpen.classList.toggle('hidden', !isPassword);
      eyeClosed.classList.toggle('hidden', isPassword);
    });

    // Bloquear espacios en la contraseña
    passwordInput.addEventListener('keydown', (e) => {
      if (e.key === ' ') e.preventDefault();
    });

    // Limitar a 20 caracteres con vibración y mensaje
    function enforcePasswordMaxLength() {
      let pwd = passwordInput.value;
      if (pwd.includes(' ')) {
        pwd = pwd.replace(/\s/g, '');
        passwordInput.value = pwd;
      }
      if (pwd.length > 20) {
        passwordInput.value = pwd.slice(0, 20);
        passwordError.textContent = '¡Máximo 20 caracteres!';
        passwordError.classList.remove('hidden');
        passwordInput.classList.add('border-red-500', 'shake');
        clearTimeout(window.pwdMaxTimeout);
        window.pwdMaxTimeout = setTimeout(() => {
          passwordError.classList.add('hidden');
          passwordInput.classList.remove('border-red-500', 'shake');
          updateSubmitButton();
        }, 2000);
      }
    }

    // Manejar pegado de texto en la contraseña
    passwordInput.addEventListener('paste', (e) => {
      e.preventDefault();
      const pasted = (e.clipboardData || window.clipboardData).getData('text');
      const cleaned = pasted.replace(/\s/g, '').slice(0, 20);
      passwordInput.value = cleaned;
      enforcePasswordMaxLength();
      updateSubmitButton();
    });

    // Validar campo vacío al perder el foco
    function checkEmpty(input, errorEl, message) {
      if (input.value.trim() === '') {
        errorEl.textContent = message;
        errorEl.classList.remove('hidden');
        input.classList.add('border-red-500');
        return false;
      } else {
        errorEl.classList.add('hidden');
        input.classList.remove('border-red-500');
        return true;
      }
    }

    emailInput.addEventListener('blur', () => checkEmpty(emailInput, emailError, '¡El correo es obligatorio!'));
    passwordInput.addEventListener('blur', () => checkEmpty(passwordInput, passwordError, '¡La contraseña es obligatoria!'));

    emailInput.addEventListener('focus', () => { emailError.classList.add('hidden'); emailInput.classList.remove('border-red-500'); });
    passwordInput.addEventListener('focus', () => {
      if (!passwordError.textContent.includes('¡Máximo 20 caracteres!')) {
        passwordError.classList.add('hidden');
        passwordInput.classList.remove('border-red-500');
      }
    });

    function updateSubmitButton() {
      const emailFilled = emailInput.value.trim() !== '';
      const passwordFilled = passwordInput.value.trim() !== '';
      submitBtn.disabled = !(emailFilled && passwordFilled);
    }

    emailInput.addEventListener('input', updateSubmitButton);
    passwordInput.addEventListener('input', () => {
      enforcePasswordMaxLength();
      updateSubmitButton();
    });

    form.addEventListener('submit', function(e) {
      const emailOk = checkEmpty(emailInput, emailError, '¡El correo es obligatorio!');
      const passwordOk = checkEmpty(passwordInput, passwordError, '¡La contraseña es obligatoria!');
      if (!emailOk || !passwordOk) {
        e.preventDefault();
      }
    });

    updateSubmitButton();
  </script>
</body>
</html>