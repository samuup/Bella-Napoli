<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Iniciar sesión - Bella Napoli</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; }
    h1, h2, .font-serif { font-family: 'Playfair Display', serif; }
    @keyframes shake {
      0% { transform: translateX(0); }
      25% { transform: translateX(-4px); }
      50% { transform: translateX(4px); }
      75% { transform: translateX(-4px); }
      100% { transform: translateX(0); }
    }
    .shake { animation: shake 0.3s ease-in-out; }
    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .fade-in-up { animation: fadeInUp 0.6s ease-out; }
    .bg-texture {
      background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ef4444' fill-opacity='0.03'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
    }
  </style>
</head>
<body class="bg-[#e8dccc] min-h-screen flex items-center justify-center p-4 bg-texture">
  <div class="w-full max-w-md fade-in-up">
    <div class="bg-[#f5efe6] rounded-2xl shadow-xl overflow-hidden border-t-4 border-red-600">
      <div class="p-8 md:p-10">
        <div class="text-center mb-6">
          <a href="/" class="inline-flex items-center justify-center space-x-2 mb-4">
            <span class="text-5xl">🍕</span>
          </a>
          <h1 class="text-3xl font-bold font-serif text-stone-800">Bella Napoli</h1>
          <p class="text-stone-500 mt-1">Inicia sesión para continuar</p>
          <div class="flex justify-center mt-4">
            <div class="w-16 h-0.5 bg-red-400 rounded-full"></div>
          </div>
        </div>

        <% if (error) { %>
          <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl mb-6 text-sm">
            <%= error %>
          </div>
        <% } %>

        <form action="/login" method="POST" id="loginForm" class="space-y-5">
          <%- include('csrf') %>
          <!-- Correo -->
          <div>
            <label class="block text-sm font-medium text-stone-700 mb-1">Correo electrónico</label>
            <input type="email" name="email" id="emailInput" required
                   class="w-full px-4 py-3 border border-stone-300 rounded-xl focus:ring-2 focus:ring-red-500 focus:border-red-500 transition"
                   placeholder="tu@correo.com">
            <p id="emailError" class="text-red-500 text-xs mt-1 hidden"></p>
          </div>
          <!-- Contraseña -->
          <div>
            <label class="block text-sm font-medium text-stone-700 mb-1">Contraseña</label>
            <div class="relative">
              <input type="password" name="password" id="passwordInput" required
                     class="w-full px-4 py-3 pr-12 border border-stone-300 rounded-xl focus:ring-2 focus:ring-red-500 focus:border-red-500 transition"
                     placeholder="••••••••">
              <button type="button" id="togglePassword"
                      class="absolute inset-y-0 right-0 pr-3 flex items-center text-stone-400 hover:text-stone-600 transition"
                      aria-label="Mostrar contraseña">
                <svg id="eyeOpen" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
                <svg id="eyeClosed" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" />
                </svg>
              </button>
            </div>
            <p id="passwordError" class="text-red-500 text-xs mt-1 hidden"></p>
          </div>
          <button type="submit" id="submitBtn"
                  class="w-full bg-red-700 hover:bg-red-800 text-white font-semibold py-3 rounded-full shadow-md hover:shadow-lg transform hover:-translate-y-0.5 transition disabled:opacity-50 disabled:cursor-not-allowed">
            Entrar
          </button>
        </form>

        <p class="text-center text-sm text-stone-500 mt-6">
          ¿No tienes cuenta? 
          <a href="/register" class="text-red-600 hover:text-red-700 font-medium underline underline-offset-2">Regístrate aquí</a>
        </p>
        <p class="text-center text-sm text-stone-500 mt-4">
          <a href="/forgot-password" class="text-red-600 hover:underline">¿Olvidaste tu contraseña?</a>
        </p>
      </div>
    </div>

    <p class="text-center text-sm text-stone-400 mt-6">
      <a href="/" class="hover:text-stone-600 transition">← Volver al menú</a>
    </p>
  </div>

  <script>
    const emailInput = document.getElementById('emailInput');
    const emailError = document.getElementById('emailError');
    const passwordInput = document.getElementById('passwordInput');
    const passwordError = document.getElementById('passwordError');
    const togglePassword = document.getElementById('togglePassword');
    const eyeOpen = document.getElementById('eyeOpen');
    const eyeClosed = document.getElementById('eyeClosed');
    const submitBtn = document.getElementById('submitBtn');
    const form = document.getElementById('loginForm');

    // Mostrar/ocultar contraseña
    togglePassword.addEventListener('click', () => {
      const isPassword = passwordInput.type === 'password';
      passwordInput.type = isPassword ? 'text' : 'password';
      eyeOpen.classList.toggle('hidden', !isPassword);
      eyeClosed.classList.toggle('hidden', isPassword);
    });

    // Bloquear espacios en la contraseña
    passwordInput.addEventListener('keydown', (e) => {
      if (e.key === ' ') e.preventDefault();
    });

    // Limitar a 20 caracteres con vibración y mensaje
    function enforcePasswordMaxLength() {
      let pwd = passwordInput.value;
      if (pwd.includes(' ')) {
        pwd = pwd.replace(/\s/g, '');
        passwordInput.value = pwd;
      }
      if (pwd.length > 20) {
        passwordInput.value = pwd.slice(0, 20);
        passwordError.textContent = '¡Máximo 20 caracteres!';
        passwordError.classList.remove('hidden');
        passwordInput.classList.add('border-red-500', 'shake');
        clearTimeout(window.pwdMaxTimeout);
        window.pwdMaxTimeout = setTimeout(() => {
          passwordError.classList.add('hidden');
          passwordInput.classList.remove('border-red-500', 'shake');
          updateSubmitButton();
        }, 2000);
      }
    }

    // Manejar pegado de texto en la contraseña
    passwordInput.addEventListener('paste', (e) => {
      e.preventDefault();
      const pasted = (e.clipboardData || window.clipboardData).getData('text');
      const cleaned = pasted.replace(/\s/g, '').slice(0, 20);
      passwordInput.value = cleaned;
      enforcePasswordMaxLength();
      updateSubmitButton();
    });

    // Validar campo vacío al perder el foco
    function checkEmpty(input, errorEl, message) {
      if (input.value.trim() === '') {
        errorEl.textContent = message;
        errorEl.classList.remove('hidden');
        input.classList.add('border-red-500');
        return false;
      } else {
        errorEl.classList.add('hidden');
        input.classList.remove('border-red-500');
        return true;
      }
    }

    emailInput.addEventListener('blur', () => checkEmpty(emailInput, emailError, '¡El correo es obligatorio!'));
    passwordInput.addEventListener('blur', () => checkEmpty(passwordInput, passwordError, '¡La contraseña es obligatoria!'));

    emailInput.addEventListener('focus', () => { emailError.classList.add('hidden'); emailInput.classList.remove('border-red-500'); });
    passwordInput.addEventListener('focus', () => {
      if (!passwordError.textContent.includes('¡Máximo 20 caracteres!')) {
        passwordError.classList.add('hidden');
        passwordInput.classList.remove('border-red-500');
      }
    });

    function updateSubmitButton() {
      const emailFilled = emailInput.value.trim() !== '';
      const passwordFilled = passwordInput.value.trim() !== '';
      submitBtn.disabled = !(emailFilled && passwordFilled);
    }

    emailInput.addEventListener('input', updateSubmitButton);
    passwordInput.addEventListener('input', () => {
      enforcePasswordMaxLength();
      updateSubmitButton();
    });

    form.addEventListener('submit', function(e) {
      const emailOk = checkEmpty(emailInput, emailError, '¡El correo es obligatorio!');
      const passwordOk = checkEmpty(passwordInput, passwordError, '¡La contraseña es obligatoria!');
      if (!emailOk || !passwordOk) {
        e.preventDefault();
      }
    });

    updateSubmitButton();
  </script>
</body>
</html>