<!-- ============================================================
  VIEW: forgot-password.ejs — Solicitud de restablecimiento
  ------------------------------------------------------------
  Variables: error, success (bool), resetLink.
============================================================ -->
<!DOCTYPE html>
<html lang="es" class="dark">
<head>
  <%- include('partials/head', { title: 'Recuperar contraseña — Bella Napoli' }) %>
  <style>
    .fl-input {
      background-color: transparent !important;
      border: 0;
      border-bottom: 1px solid #fff5e6;
      color: #fff5e6;
      -webkit-text-fill-color: #fff5e6;
      caret-color: #fff5e6;
      width: 100%;
      padding: 0.5rem 0;
      font-family: 'Manrope', sans-serif;
    }
    .fl-input:focus { outline: none; border-color: #d32f2f; }
    .fl-input::placeholder { color: #8e9192; }
    input:-webkit-autofill,
    input:-webkit-autofill:hover,
    input:-webkit-autofill:focus {
      -webkit-text-fill-color: #fff5e6;
      -webkit-box-shadow: 0 0 0 1000px #2e2920 inset;
      caret-color: #fff5e6;
      transition: background-color 9999s ease-in-out 0s;
    }
  </style>
</head>
<body class="bg-background text-on-background min-h-screen flex items-center justify-center p-4 relative overflow-x-hidden font-sans">
  <div class="texture-overlay"></div>
  <div class="w-full max-w-md">
    <div class="bg-surface-container-high border border-outline-variant ambient-shadow overflow-hidden border-t-4 border-t-brand-red">
      <div class="p-8">
        <div class="text-center mb-6">
          <span class="text-5xl">🔑</span>
          <h1 class="font-display text-headline-lg text-brand-cream">Recuperar contraseña</h1>
          <p class="font-sans text-body-md text-on-surface-variant mt-1">Ingresa tu correo electrónico</p>
        </div>

        <% if (error) { %>
          <div class="bg-red-900/40 border border-brand-red text-brand-cream px-4 py-3 mb-6 font-sans text-body-md"><%= error %></div>
        <% } %>

        <% if (success) { %>
          <div class="bg-brand-green/15 border border-brand-green text-brand-green px-4 py-3 mb-6 font-sans text-body-md">
            Revisa tu correo (o la consola) para el enlace de restablecimiento.
            <% if (resetLink) { %>
              <p class="mt-2 font-sans text-body-md">Enlace de desarrollo: <a href="<%= resetLink %>" class="underline text-blue-400"><%= resetLink %></a></p>
            <% } %>
          </div>
        <% } %>

        <form action="/forgot-password" method="POST" class="space-y-5">
          <%- include('csrf') %>
          <label class="block">
            <span class="font-label-caps text-label-caps text-on-surface-variant uppercase tracking-widest">Correo electrónico</span>
            <input type="email" name="email" required class="fl-input mt-1">
          </label>
          <button type="submit" class="w-full bg-brand-red hover:bg-red-800 text-brand-cream font-label-caps text-label-caps py-3 rounded-none transition active:scale-[0.99]">Enviar instrucciones</button>
        </form>

        <p class="text-center font-sans text-body-md text-on-surface-variant mt-6">
          <a href="/login" class="text-brand-red hover:underline">Volver al inicio de sesión</a>
        </p>
      </div>
    </div>
  </div>
</body>
</html>