<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Recuperar contraseña - Bella Napoli</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; }
    h1, h2, .font-serif { font-family: 'Playfair Display', serif; }
  </style>
</head>
<body class="bg-stone-50 min-h-screen flex items-center justify-center p-4 bg-gradient-to-br from-red-50 via-stone-50 to-stone-100">
  <div class="w-full max-w-md">
    <div class="bg-white rounded-2xl shadow-xl overflow-hidden border-t-4 border-red-600">
      <div class="p-8">
        <div class="text-center mb-6">
          <span class="text-5xl">🔑</span>
          <h1 class="text-3xl font-bold font-serif text-stone-800">Recuperar contraseña</h1>
          <p class="text-stone-500 mt-1">Ingresa tu correo electrónico</p>
        </div>

        <% if (error) { %>
          <div class="bg-red-100 border border-red-300 text-red-800 px-4 py-3 rounded-2xl mb-6"><%= error %></div>
        <% } %>

        <% if (success) { %>
          <div class="bg-green-100 border border-green-300 text-green-800 px-4 py-3 rounded-2xl mb-6">
            Revisa tu correo (o la consola) para el enlace de restablecimiento.
            <% if (resetLink) { %>
              <p class="mt-2 text-sm">Enlace de desarrollo: <a href="<%= resetLink %>" class="underline text-blue-600"><%= resetLink %></a></p>
            <% } %>
          </div>
        <% } %>

        <form action="/forgot-password" method="POST" class="space-y-5">
          <%- include('csrf') %>
          <label class="block">
            <span class="text-stone-700 font-medium">Correo electrónico</span>
            <input type="email" name="email" required class="mt-1 block w-full border border-stone-300 rounded-xl p-3 focus:ring-2 focus:ring-red-500 focus:border-red-500 transition">
          </label>
          <button type="submit" class="w-full bg-red-700 hover:bg-red-800 text-white font-bold py-3 rounded-full transition">Enviar instrucciones</button>
        </form>

        <p class="text-center text-sm text-stone-500 mt-6">
          <a href="/login" class="text-red-600 hover:underline">Volver al inicio de sesión</a>
        </p>
      </div>
    </div>
  </div>
</body>
</html>