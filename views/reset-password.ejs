<!-- ============================================================
  VIEW: reset-password.ejs — Establecer nueva contraseña
  ------------------------------------------------------------
  Variables: token, error.
============================================================ -->
<!DOCTYPE html>
<html lang="es" class="dark">
<head>
  <%- include('partials/head', { title: 'Restablecer contraseña — Bella Napoli' }) %>
  <style>
    @keyframes shake {
      0% { transform: translateX(0); }
      25% { transform: translateX(-4px); }
      50% { transform: translateX(4px); }
      75% { transform: translateX(-4px); }
      100% { transform: translateX(0); }
    }
    .shake { animation: shake 0.3s ease-in-out; }
    .fl-input {
      background-color: transparent !important;
      border: 0;
      border-bottom: 1px solid #fff5e6;
      color: #fff5e6;
      -webkit-text-fill-color: #fff5e6;
      caret-color: #fff5e6;
      width: 100%;
      padding: 0.5rem 0;
      font-family: 'Manrope', sans-serif;
    }
    .fl-input:focus { outline: none; border-color: #d32f2f; }
    .fl-input::placeholder { color: #8e9192; }
    input:-webkit-autofill,
    input:-webkit-autofill:hover,
    input:-webkit-autofill:focus {
      -webkit-text-fill-color: #fff5e6;
      -webkit-box-shadow: 0 0 0 1000px #2e2920 inset;
      caret-color: #fff5e6;
      transition: background-color 9999s ease-in-out 0s;
    }
  </style>
</head>
<body class="bg-background text-on-background min-h-screen flex items-center justify-center p-4 relative overflow-x-hidden font-sans">
  <div class="texture-overlay"></div>
  <div class="w-full max-w-md">
    <div class="bg-surface-container-high border border-outline-variant ambient-shadow overflow-hidden border-t-4 border-t-brand-red">
      <div class="p-8">
        <div class="text-center mb-6">
          <span class="text-5xl">🔒</span>
          <h1 class="font-display text-headline-lg text-brand-cream">Nueva contraseña</h1>
          <p class="font-sans text-body-md text-on-surface-variant mt-1">Elige una contraseña segura</p>
        </div>

        <% if (error) { %>
          <div class="bg-red-900/40 border border-brand-red text-brand-cream px-4 py-3 mb-6 font-sans text-body-md"><%= error %></div>
        <% } %>

        <% if (token) { %>
        <form action="/reset-password/<%= token %>" method="POST" id="resetForm" class="space-y-5">
          <%- include('csrf') %>

          <!-- Contraseña -->
          <div>
            <label class="block font-label-caps text-label-caps text-on-surface-variant uppercase tracking-widest mb-1">Contraseña</label>
            <div class="relative">
              <input type="password" name="password" id="passwordInput" required
                     class="fl-input pr-12"
                     placeholder="••••••••">
              <button type="button" id="togglePassword" class="absolute inset-y-0 right-0 pr-3 flex items-center text-on-surface-variant hover:text-brand-cream transition" aria-label="Mostrar contraseña">
                <svg id="eyeOpen" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
                <svg id="eyeClosed" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21" />
                </svg>
              </button>
            </div>
            <p id="maxLengthError" class="text-brand-red font-sans text-sm mt-1 hidden font-medium"></p>
            <div class="mt-2 space-y-1">
              <div class="flex items-center font-sans text-body-md text-on-surface-variant" id="req-length">
                <span class="w-4 h-4 inline-flex items-center justify-center rounded-full border border-outline-variant mr-2 text-[10px]">○</span>
                Mínimo 8 caracteres
              </div>
              <div class="flex items-center font-sans text-body-md text-on-surface-variant" id="req-uppercase">
                <span class="w-4 h-4 inline-flex items-center justify-center rounded-full border border-outline-variant mr-2 text-[10px]">○</span>
                Al menos una mayúscula
              </div>
              <div class="flex items-center font-sans text-body-md text-on-surface-variant" id="req-number">
                <span class="w-4 h-4 inline-flex items-center justify-center rounded-full border border-outline-variant mr-2 text-[10px]">○</span>
                Al menos un número
              </div>
              <div class="flex items-center font-sans text-body-md text-on-surface-variant" id="req-special">
                <span class="w-4 h-4 inline-flex items-center justify-center rounded-full border border-outline-variant mr-2 text-[10px]">○</span>
                Al menos un carácter especial (!@#$%^&*)
              </div>
            </div>
          </div>

          <!-- Repetir contraseña -->
          <div>
            <label class="block font-label-caps text-label-caps text-on-surface-variant uppercase tracking-widest mb-1">Repetir contraseña</label>
            <input type="password" name="password2" id="password2Input" required
                   class="fl-input"
                   placeholder="••••••••">
            <p id="matchMessage" class="text-brand-red font-sans text-sm mt-1 hidden"></p>
          </div>

          <button type="submit" id="submitBtn"
                  class="w-full bg-brand-red hover:bg-red-800 text-brand-cream font-label-caps text-label-caps py-3 rounded-none transition active:scale-[0.99] disabled:opacity-50 disabled:cursor-not-allowed">
            Restablecer contraseña
          </button>
        </form>
        <% } else { %>
          <p class="text-center font-sans text-body-md text-on-surface-variant">El enlace no es válido.</p>
        <% } %>
      </div>
    </div>
  </div>

  <script>
    const passwordInput = document.getElementById('passwordInput');
    const password2Input = document.getElementById('password2Input');
    const submitBtn = document.getElementById('submitBtn');
    const reqLength = document.getElementById('req-length');
    const reqUppercase = document.getElementById('req-uppercase');
    const reqNumber = document.getElementById('req-number');
    const reqSpecial = document.getElementById('req-special');
    const maxLengthError = document.getElementById('maxLengthError');
    const matchMessage = document.getElementById('matchMessage');

    function setRequirement(element, fulfilled) {
      const circle = element.querySelector('span');
      if (fulfilled) {
        circle.innerHTML = '✓';
        circle.classList.add('bg-green-500', 'text-white', 'border-green-500');
        circle.classList.remove('border-outline-variant');
        element.classList.remove('text-on-surface-variant');
        element.classList.add('text-green-400');
      } else {
        circle.innerHTML = '○';
        circle.classList.remove('bg-green-500', 'text-white', 'border-green-500');
        circle.classList.add('border-outline-variant');
        element.classList.add('text-on-surface-variant');
        element.classList.remove('text-green-400');
      }
    }

    function showTemporaryError(input, errorEl, message) {
      errorEl.textContent = message;
      errorEl.classList.remove('hidden');
      input.classList.add('border-red-500', 'shake');
      clearTimeout(window.tempErrorTimeout);
      window.tempErrorTimeout = setTimeout(() => {
        errorEl.classList.add('hidden');
        input.classList.remove('border-red-500', 'shake');
      }, 2000);
    }

    function enforceMaxLength(input, errorEl) {
      let value = input.value;
      if (value.includes(' ')) {
        value = value.replace(/\s/g, '');
        input.value = value;
      }
      if (value.length > 20) {
        input.value = value.slice(0, 20);
        showTemporaryError(input, errorEl, '¡Máximo 20 caracteres!');
      }
    }

    function validatePassword() {
      enforceMaxLength(passwordInput, maxLengthError);
      const pwd = passwordInput.value;
      const lengthValid = pwd.length >= 8 && pwd.length <= 20;
      const uppercaseValid = /[A-Z]/.test(pwd);
      const numberValid = /[0-9]/.test(pwd);
      const specialValid = /[!@#$%^&*(),.?":{}|<>]/.test(pwd);
      setRequirement(reqLength, lengthValid);
      setRequirement(reqUppercase, uppercaseValid);
      setRequirement(reqNumber, numberValid);
      setRequirement(reqSpecial, specialValid);
      return lengthValid && uppercaseValid && numberValid && specialValid;
    }

    function checkPasswordsMatch() {
      enforceMaxLength(password2Input, matchMessage);
      if (password2Input.value === '') {
        matchMessage.classList.add('hidden');
        password2Input.classList.remove('border-red-500');
        return false;
      }
      if (passwordInput.value !== password2Input.value) {
        matchMessage.textContent = 'Las contraseñas no coinciden.';
        matchMessage.classList.remove('hidden');
        password2Input.classList.add('border-red-500');
        return false;
      }
      matchMessage.classList.add('hidden');
      password2Input.classList.remove('border-red-500');
      return true;
    }

    function updateSubmitButton() {
      const passwordValid = validatePassword();
      const passwordsMatch = checkPasswordsMatch();
      submitBtn.disabled = !(passwordValid && passwordsMatch);
    }

    // Bloquear espacios y pegado en contraseña
    passwordInput.addEventListener('keydown', (e) => {
      if (e.key === ' ') e.preventDefault();
    });
    passwordInput.addEventListener('paste', (e) => {
      e.preventDefault();
      showTemporaryError(passwordInput, maxLengthError, 'No se permite pegar la contraseña.');
    });
    passwordInput.addEventListener('input', () => {
      validatePassword();
      checkPasswordsMatch();
      updateSubmitButton();
    });

    // Bloquear espacios y pegado en repetir contraseña
    password2Input.addEventListener('keydown', (e) => {
      if (e.key === ' ') e.preventDefault();
    });
    password2Input.addEventListener('paste', (e) => {
      e.preventDefault();
      showTemporaryError(password2Input, matchMessage, 'No se permite pegar la contraseña.');
    });
    password2Input.addEventListener('input', () => {
      checkPasswordsMatch();
      updateSubmitButton();
    });

    // Mostrar/ocultar contraseña
    document.getElementById('togglePassword').addEventListener('click', () => {
      const isPassword = passwordInput.type === 'password';
      passwordInput.type = isPassword ? 'text' : 'password';
      document.getElementById('eyeOpen').classList.toggle('hidden', !isPassword);
      document.getElementById('eyeClosed').classList.toggle('hidden', isPassword);
    });

    updateSubmitButton();
  </script>
</body>
</html>