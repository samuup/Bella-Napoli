<!-- ============================================================
  VIEW: print-order.ejs — Comanda/imprimir pedido (admin)
  ------------------------------------------------------------
  Vista optimizada para impresión (@media print).
  Variables: order, items, bebidas.
============================================================ -->
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Comanda #<%= order.id %> - Bella Napoli</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    @media print {
      .no-print { display: none !important; }
      body { background: white; }
      .ticket { box-shadow: none; }
    }
    body { font-family: 'Inter', sans-serif; }
    h1, h2, h3, .font-serif { font-family: 'Playfair Display', serif; }
  </style>
</head>
<body class="bg-[#e8dccc] flex items-center justify-center min-h-screen p-4">
  <div class="ticket bg-[#f5efe6] rounded-2xl shadow-xl p-8 max-w-md w-full">
    <div class="text-center mb-6">
      <span class="text-5xl">🍕</span>
      <h1 class="text-3xl font-bold font-serif text-stone-800">Bella Napoli</h1>
      <p class="text-stone-500">Comanda de pedido</p>
    </div>

    <div class="text-sm text-stone-600 space-y-1 mb-4">
      <p><strong>Pedido #:</strong> <%= order.id %></p>
      <p><strong>Fecha:</strong> <%= new Date(order.created_at).toLocaleString() %></p>
      <p><strong>Recogida:</strong> <%= order.pickup_time %></p>
      <p><strong>Cliente:</strong> <%= order.customer_name %></p>
      <p><strong>Teléfono:</strong> <%= order.phone %></p>
      <p><strong>Pago:</strong> <%= order.payment_method %></p>
    </div>

    <div class="border-t border-dashed py-4">
      <h2 class="font-bold text-lg mb-2">Artículos</h2>
      <ul class="space-y-2 text-sm text-stone-700">
        <% items.forEach(item => { %>
          <li class="flex justify-between">
            <span>
              <strong><%= item.quantity %>x</strong> <%= item.pizza_name %> (<%= item.size_label %>)
              <% if (item.toppings.length) { %> + <%= item.toppings.join(', ') %><% } %>
            </span>
            <span>$<%= item.line_total.toFixed(2) %></span>
          </li>
        <% }) %>
        <% bebidas.forEach(b => { %>
          <li class="flex justify-between">
            <span><strong><%= b.quantity %>x</strong> <%= b.name %></span>
            <span>$<%= b.line_total.toFixed(2) %></span>
          </li>
        <% }) %>
      </ul>
    </div>

    <div class="border-t border-dashed py-4 flex justify-between text-lg font-bold">
      <span>Total</span>
      <span>$<%= order.total %></span>
    </div>

    <div class="text-center mt-4 text-xs text-stone-400">
      ¡Gracias por su compra!
    </div>

    <div class="no-print mt-6 flex justify-center">
      <button onclick="window.print()" class="bg-red-700 hover:bg-red-800 text-white font-bold py-2 px-6 rounded-full transition">
        🖨️ Imprimir comanda
      </button>
    </div>
  </div>
</body>
</html>