<!-- ============================================================
  VIEW: print-order.ejs — Comanda/imprimir pedido (admin)
  ------------------------------------------------------------
  Vista optimizada para impresión (@media print).
  Variables: order, items, bebidas.
============================================================ -->
<!DOCTYPE html>
<html lang="es" class="dark">
<head>
  <%- include('partials/head', { title: `Comanda #${order.id} — Bella Napoli` }) %>
  <style>
    @media print {
      .no-print { display: none !important; }
      body { background: white !important; }
      .ticket { box-shadow: none !important; border: none !important; }
    }
    .ticket-body {
      font-family: 'Manrope', sans-serif;
    }
  </style>
</head>
<body class="bg-surface-container-lowest flex items-center justify-center min-h-screen p-4 font-sans">
  <div class="ticket bg-brand-cream border border-outline-variant/40 shadow-xl p-8 max-w-md w-full">
    <div class="text-center mb-6">
      <span class="text-5xl">🍕</span>
      <h1 class="font-display text-headline-lg text-stone-900">Bella Napoli</h1>
      <p class="font-sans text-body-md text-stone-600">Comanda de pedido</p>
    </div>

    <div class="font-sans text-body-md text-stone-700 space-y-1 mb-4">
      <p><strong class="text-stone-900">Pedido #:</strong> <%= order.id %></p>
      <p><strong class="text-stone-900">Fecha:</strong> <%= new Date(order.created_at).toLocaleString() %></p>
      <p><strong class="text-stone-900">Recogida:</strong> <%= order.pickup_time %></p>
      <p><strong class="text-stone-900">Cliente:</strong> <%= order.customer_name %></p>
      <p><strong class="text-stone-900">Teléfono:</strong> <%= order.phone %></p>
      <p><strong class="text-stone-900">Pago:</strong> <%= order.payment_method %></p>
    </div>

    <div class="border-t border-dashed border-stone-400 py-4">
      <h2 class="font-display text-headline-md text-stone-900 mb-2">Artículos</h2>
      <ul class="space-y-2 font-sans text-body-md text-stone-700">
        <% items.forEach(item => { %>
          <li class="flex justify-between">
            <span>
              <strong class="text-stone-900"><%= item.quantity %>x</strong> <%= item.pizza_name %> (<%= item.size_label %>)
              <% if (item.toppings.length) { %> + <%= item.toppings.join(', ') %><% } %>
            </span>
            <span class="text-stone-900">$<%= item.line_total.toFixed(2) %></span>
          </li>
        <% }) %>
        <% bebidas.forEach(b => { %>
          <li class="flex justify-between">
            <span><strong class="text-stone-900"><%= b.quantity %>x</strong> <%= b.name %></span>
            <span class="text-stone-900">$<%= b.line_total.toFixed(2) %></span>
          </li>
        <% }) %>
      </ul>
    </div>

    <div class="border-t border-dashed border-stone-400 py-4 flex justify-between font-display text-price-display text-stone-900">
      <span>Total</span>
      <span>$<%= order.total %></span>
    </div>

    <div class="text-center mt-4 font-sans text-body-md text-stone-500">
      ¡Gracias por su compra!
    </div>

    <div class="no-print mt-6 flex justify-center">
      <button onclick="window.print()" class="bg-brand-red hover:bg-red-800 text-brand-cream font-label-caps text-label-caps py-2 px-6 rounded-none transition">
        🖨️ Imprimir comanda
      </button>
    </div>
  </div>
</body>
</html>