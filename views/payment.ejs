<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Realizar pago - Bella Napoli</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; }
    h1, h2, h3, .font-serif { font-family: 'Playfair Display', serif; }
  </style>
</head>
<body class="bg-stone-50 min-h-screen flex items-center justify-center p-4">
  <div class="w-full max-w-lg">
    <div class="bg-white rounded-2xl shadow-xl overflow-hidden border-t-4 border-red-600">
      <div class="p-8">
        <div class="text-center mb-6">
          <span class="text-5xl">💳</span>
          <h1 class="text-3xl font-bold font-serif text-stone-800">Finalizar pago</h1>
          <p class="text-stone-500">Pedido #<%= order.id %> - Total $<%= order.total %></p>
        </div>

        <% if (error) { %>
          <div class="bg-red-100 border border-red-300 text-red-800 px-4 py-3 rounded-2xl mb-6"><%= error %></div>
        <% } %>

        <div class="bg-stone-50 rounded-xl p-4 mb-6 text-sm text-stone-600">
            <p><strong>Método de pago:</strong> <%= order.payment_method %></p>
            <% if (paymentData) { %>
                <p><strong>Instrucciones:</strong></p>
                <ul class="list-disc list-inside">
                <% paymentData.instructions.forEach(instruction => { %>
                    <li><%= instruction %></li>
                <% }) %>
                </ul>
            <% } else { %>
                <p>Información de pago no disponible para este método.</p>
            <% } %>
        </div>

        <form action="/payment/<%= order.id %>" method="POST" enctype="multipart/form-data" class="space-y-4">
          <%- include('csrf') %>
          <label class="block">
            <span class="text-stone-700 font-medium">Número de referencia</span>
            <input type="text" name="payment_ref" id="paymentRef" placeholder="123456"
                inputmode="numeric" pattern="\d{6}" title="Solo 6 dígitos"
                class="mt-1 block w-full border border-stone-300 rounded-xl p-3 focus:ring-2 focus:ring-red-500 focus:border-red-500">

          </label>
          <label class="block">
            <span class="text-stone-700 font-medium">Comprobante (imagen)</span>
            <input type="file" name="receipt" accept="image/jpeg,image/png,image/webp"
                   class="mt-1 block w-full border border-stone-300 rounded-xl p-3">
          </label>
          <button type="submit" class="w-full bg-red-700 hover:bg-red-800 text-white font-bold py-3 rounded-full transition">
            Ya pagué
          </button>
        </form>
      </div>
    </div>
  </div>

  <script>
    const paymentRefInput = document.getElementById('paymentRef');
    paymentRefInput.addEventListener('input', function(e) {
        // Eliminar todo lo que no sea dígito y limitar a 6
        this.value = this.value.replace(/\D/g, '').slice(0, 6);
    });
  </script>

</body>
</html>