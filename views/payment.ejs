<!-- ============================================================
  VIEW: payment.ejs — Pantalla de pago / subir comprobante
  ------------------------------------------------------------
  Permite ingresar el número de referencia O subir una imagen
  de comprobante. El pedido solo se crea en la BD al confirmar
  esta pantalla. Variables: order, error, paymentData.
============================================================ -->
<!DOCTYPE html>
<html lang="es" class="dark">
<head>
  <%- include('partials/head', { title: 'Realizar pago — Bella Napoli' }) %>
  <style>
    .fl-input {
      background-color: transparent !important;
      border: 0;
      border-bottom: 1px solid #fff5e6;
      color: #fff5e6;
      -webkit-text-fill-color: #fff5e6;
      caret-color: #fff5e6;
      width: 100%;
      padding: 0.5rem 0;
      font-family: 'Manrope', sans-serif;
    }
    .fl-input:focus {
      outline: none;
      border-color: #d32f2f;
    }
    .fl-input::placeholder {
      color: #8e9192;
    }
    input:-webkit-autofill,
    input:-webkit-autofill:hover,
    input:-webkit-autofill:focus {
      -webkit-text-fill-color: #fff5e6;
      -webkit-box-shadow: 0 0 0 1000px #2e2920 inset;
      caret-color: #fff5e6;
      transition: background-color 9999s ease-in-out 0s;
    }
    input[type="file"].fl-file {
      background: transparent;
      border: 1px solid #444748;
      color: #c4c7c7;
      padding: 0.6rem;
      border-radius: 0;
      font-family: 'Manrope', sans-serif;
    }
  </style>
</head>
<body class="bg-background text-on-background min-h-screen flex items-center justify-center p-4 relative overflow-x-hidden font-sans">
  <div class="texture-overlay"></div>
  <div class="w-full max-w-lg">
    <div class="bg-surface-container-high border border-outline-variant ambient-shadow overflow-hidden">
      <div class="p-8">
        <div class="text-center mb-6">
          <span class="text-5xl">💳</span>
          <h1 class="font-display text-headline-lg text-brand-cream">Finalizar pago</h1>
          <p class="font-sans text-body-md text-on-surface-variant">Total <span class="font-display text-price-display text-brand-red">$<%= order.total %></span></p>
        </div>

        <% if (error) { %>
          <div class="bg-red-900/40 border border-brand-red text-brand-cream px-4 py-3 mb-6 font-sans text-body-md"><%= error %></div>
        <% } %>

        <div class="bg-surface-container border border-outline-variant p-4 mb-6 font-sans text-body-md text-on-surface-variant">
            <p class="text-on-surface"><strong>Método de pago:</strong> <%= order.payment_method %></p>
            <% if (paymentData) { %>
                <p class="mt-2 text-label-caps text-label-caps text-brand-red uppercase tracking-widest">Instrucciones</p>
                <ul class="list-disc list-inside mt-1">
                <% paymentData.instructions.forEach(instruction => { %>
                    <li><%= instruction %></li>
                <% }) %>
                </ul>
            <% } else { %>
                <p>Información de pago no disponible para este método.</p>
            <% } %>
        </div>

        <form action="/payment" method="POST" enctype="multipart/form-data" class="space-y-6">
          <%- include('csrf') %>
          <label class="block">
            <span class="font-label-caps text-label-caps text-on-surface-variant uppercase tracking-widest">Número de referencia</span>
            <input type="text" name="payment_ref" id="paymentRef" placeholder="123456"
                inputmode="numeric" pattern="\d{6}" title="Solo 6 dígitos"
                class="fl-input mt-1">

          </label>
          <label class="block">
            <span class="font-label-caps text-label-caps text-on-surface-variant uppercase tracking-widest">Comprobante (imagen)</span>
            <input type="file" name="receipt" accept="image/jpeg,image/png,image/webp"
                   class="fl-file mt-2 block w-full">
          </label>
          <button type="submit" class="w-full bg-brand-red hover:bg-red-800 text-brand-cream font-label-caps text-label-caps py-4 rounded-none transition active:scale-[0.99]">
            Ya pagué
          </button>
        </form>
      </div>
    </div>
  </div>

  <script>
    const paymentRefInput = document.getElementById('paymentRef');
    paymentRefInput.addEventListener('input', function(e) {
        // Eliminar todo lo que no sea dígito y limitar a 6
        this.value = this.value.replace(/\D/g, '').slice(0, 6);
    });
  </script>

</body>
</html>