<!-- ============================================================
  VIEW: order-confirmation.ejs — Pedido completado / resumen
  ------------------------------------------------------------
  Mostrado tras enviar el pedido (efectivo) o tras pagar.
  Variables: customerName, pickup_time, payment_method, items,
             bebidas, total.
============================================================ -->
<!DOCTYPE html>
<html lang="es" class="dark">
<head>
  <%- include('partials/head', { title: 'Pedido Confirmado — Bella Napoli' }) %>
  <style>
    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .fade-in-up { animation: fadeInUp 0.6s ease-out; }
  </style>
</head>
<body class="bg-background text-on-background min-h-screen flex items-center justify-center p-4 relative overflow-x-hidden font-sans">
  <div class="texture-overlay"></div>
  <div class="w-full max-w-lg fade-in-up">
    <div class="bg-surface-container-high border border-outline-variant ambient-shadow overflow-hidden border-t-4 border-t-brand-green">
      <div class="p-8 md:p-10 text-center">
        <div class="flex justify-center mb-4">
          <span class="text-5xl">✅</span>
        </div>
        <h1 class="font-display text-headline-lg text-brand-cream">¡Pedido recibido!</h1>
        <p class="font-sans text-body-md text-on-surface-variant mt-2 mb-6">Gracias, <strong class="text-on-surface"><%= customerName %></strong>.</p>

        <div class="bg-surface-container border border-outline-variant p-4 mb-4 font-sans text-body-md text-on-surface-variant flex justify-center gap-6">
          <span><strong class="text-on-surface">Recogida:</strong> <%= pickup_time %></span>
          <span><strong class="text-on-surface">Pago:</strong> <%= payment_method %></span>
        </div>

        <div class="text-left bg-surface-container border border-outline-variant p-4 mb-6">
          <h2 class="font-display text-headline-md text-brand-cream mb-2">Resumen</h2>

          <% if (items.length > 0) { %>
            <p class="font-sans text-body-md text-on-surface-variant mb-1">🍕 Pizzas</p>
            <ul class="list-disc list-inside space-y-1 mb-4 font-sans text-body-md text-on-surface">
              <% items.forEach(item => { %>
                <li>
                  <%= item.quantity %>x <%= item.pizzaName %> (<%= item.sizeLabel %>)
                  <% if (item.toppings.length > 0) { %> + <%= item.toppings.join(', ') %><% } %>
                  = <strong class="text-brand-red">$<%= item.lineTotal.toFixed(2) %></strong>
                </li>
              <% }) %>
            </ul>
          <% } %>

          <% if (bebidas.length > 0) { %>
            <p class="font-sans text-body-md text-on-surface-variant mb-1">🥤 Bebidas</p>
            <ul class="list-disc list-inside space-y-1 mb-4 font-sans text-body-md text-on-surface">
              <% bebidas.forEach(b => { %>
                <li>
                  <%= b.quantity %>x <%= b.name %> = <strong class="text-brand-red">$<%= b.lineTotal.toFixed(2) %></strong>
                </li>
              <% }) %>
            </ul>
          <% } %>

          <div class="flex justify-between items-center mt-4 pt-4 border-t border-outline-variant">
            <span class="font-sans text-body-lg text-on-surface font-bold">Total</span>
            <span class="font-display text-price-display text-brand-red">$<%= total %></span>
          </div>
        </div>

        <a href="/order" class="inline-flex items-center justify-center w-full bg-brand-red hover:bg-red-800 text-brand-cream font-label-caps text-label-caps py-3 px-6 rounded-none transition">
          Hacer otro pedido
        </a>
        <a href="/" class="inline-block mt-4 font-sans text-body-md text-on-surface-variant hover:text-brand-cream transition">
          ← Volver al menú
        </a>
      </div>
    </div>
  </div>
</body>
</html>