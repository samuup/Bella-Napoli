<!-- ============================================================
  VIEW: order-confirmation.ejs — Pedido completado / resumen
  ------------------------------------------------------------
  Mostrado tras enviar el pedido (efectivo) o tras pagar.
  Variables: customerName, pickup_time, payment_method, items,
             bebidas, total.
============================================================ -->
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pedido Confirmado - Bella Napoli</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; }
    h1, h2, h3, .font-serif { font-family: 'Playfair Display', serif; }
    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .fade-in-up { animation: fadeInUp 0.6s ease-out; }
  </style>
</head>
<body class="bg-[#e8dccc] min-h-screen flex items-center justify-center p-4">
  <div class="w-full max-w-lg fade-in-up">
    <div class="bg-[#f5efe6] rounded-2xl shadow-xl overflow-hidden border-t-4 border-green-600">
      <div class="p-8 md:p-10 text-center">
        <div class="flex justify-center mb-4">
          <span class="text-5xl">✅</span>
        </div>
        <h1 class="text-3xl font-bold font-serif text-stone-800">¡Pedido recibido!</h1>
        <p class="text-stone-500 mt-2 mb-6">Gracias, <strong><%= customerName %></strong>.</p>
        
        <div class="bg-[#f5efe6] rounded-xl p-4 mb-4 text-sm text-stone-600 flex justify-center gap-6">
          <span><strong>Recogida:</strong> <%= pickup_time %></span>
          <span><strong>Pago:</strong> <%= payment_method %></span>
        </div>

        <div class="text-left bg-[#f5efe6] p-4 rounded-xl mb-6">
          <h2 class="font-bold font-serif text-lg mb-2 text-stone-700">Resumen</h2>
          
          <% if (items.length > 0) { %>
            <p class="text-sm font-medium text-stone-500 mb-1">🍕 Pizzas</p>
            <ul class="list-disc list-inside space-y-1 mb-4">
              <% items.forEach(item => { %>
                <li class="text-stone-700">
                  <%= item.quantity %>x <%= item.pizzaName %> (<%= item.sizeLabel %>)
                  <% if (item.toppings.length > 0) { %> + <%= item.toppings.join(', ') %><% } %>
                  = <strong>$<%= item.lineTotal.toFixed(2) %></strong>
                </li>
              <% }) %>
            </ul>
          <% } %>

          <% if (bebidas.length > 0) { %>
            <p class="text-sm font-medium text-stone-500 mb-1">🥤 Bebidas</p>
            <ul class="list-disc list-inside space-y-1 mb-4">
              <% bebidas.forEach(b => { %>
                <li class="text-stone-700">
                  <%= b.quantity %>x <%= b.name %> = <strong>$<%= b.lineTotal.toFixed(2) %></strong>
                </li>
              <% }) %>
            </ul>
          <% } %>

          <div class="flex justify-between items-center mt-4 pt-4 border-t border-stone-200">
            <span class="text-lg font-bold text-stone-700">Total</span>
            <span class="text-2xl font-bold text-red-600">$<%= total %></span>
          </div>
        </div>
        
        <a href="/order" class="inline-flex items-center justify-center w-full bg-red-700 hover:bg-red-800 text-[#f5efe6] font-bold py-3 px-6 rounded-full shadow-md hover:shadow-lg transition">
          Hacer otro pedido
        </a>
        <a href="/" class="inline-block mt-4 text-sm text-stone-400 hover:text-[#f5efe6] transition">
          ← Volver al menú
        </a>
      </div>
    </div>
  </div>
</body>
</html>