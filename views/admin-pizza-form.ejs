<!-- ============================================================
  VIEW: admin-pizza-form.ejs — Crear / Editar pizza (admin)
  ------------------------------------------------------------
  Formulario usado tanto para agregar como editar pizzas y sus
  precios por tamaño. Incluye validación en cliente (JS).
  Variables: pizza (null si es nueva), sizes, prices, error.
============================================================ -->
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <%- include('partials/head', { title: (pizza ? 'Editar' : 'Nueva') + ' Pizza - Admin' }) %>
</head>
<body class="bg-background text-on-surface flex">
  <%- include('admin-sidebar') %>
  <div class="ml-64 p-8 flex-1">
    <h1 class="text-4xl font-bold font-display text-on-surface mb-8"><%= pizza ? 'Editar' : 'Nueva' %> Pizza</h1>
    <% if (error) { %>
      <div class="bg-brand-red/10 border border-brand-red/40 text-red-300 px-4 py-3 rounded-none mb-6"><%= error %></div>
    <% } %>

    <form action="<%= pizza ? '/admin/pizzas/edit/' + pizza.id : '/admin/pizzas/add' %>" method="POST" class="bg-surface-container border border-outline-variant rounded-none shadow-md p-8 max-w-2xl">
      <%- include('csrf') %>
      <!-- Nombre -->
      <label class="block mb-5">
        <span class="text-on-surface font-medium">Nombre</span>
        <input type="text" name="name" id="pizzaName" required value="<%= pizza ? pizza.name : '' %>"
               pattern="^[A-Za-záéíóúüñÁÉÍÓÚÜÑ\s.,]+$" title="Solo letras"
               class="mt-1 block w-full bg-surface-container border border-outline-variant text-on-surface rounded-none p-3 focus:ring-2 focus:ring-brand-red focus:border-brand-red transition placeholder:text-on-surface-variant/60">
        <p id="pizzaNameError" class="text-brand-red text-xs mt-1 hidden">Solo letras permitidas.</p>
      </label>
      <!-- Descripción -->
      <label class="block mb-5">
        <span class="text-on-surface font-medium">Descripción</span>
        <textarea name="description" id="pizzaDescription" 
                  class="mt-1 block w-full bg-surface-container border border-outline-variant text-on-surface rounded-none p-3 focus:ring-2 focus:ring-brand-red focus:border-brand-red transition placeholder:text-on-surface-variant/60"><%= pizza ? pizza.description : '' %></textarea>
        <p id="pizzaDescError" class="text-brand-red text-xs mt-1 hidden">Solo letras y espacios permitidos.</p>
      </label>
      <!-- Activo -->
      <label class="block mb-6">
        <span class="text-on-surface font-medium">Activa</span>
        <select name="active" class="mt-1 block w-full bg-surface-container border border-outline-variant text-on-surface rounded-none p-3 focus:ring-2 focus:ring-brand-red focus:border-brand-red transition">
          <option value="1" <%= pizza && pizza.active ? 'selected' : '' %>>Sí</option>
          <option value="0" <%= pizza && !pizza.active ? 'selected' : '' %>>No</option>
        </select>
      </label>

      <h2 class="text-2xl font-bold font-display text-on-surface mb-4">Precios</h2>
      <% sizes.forEach(size => { %>
        <label class="block mb-4">
          <span class="text-on-surface font-medium"><%= size.label %></span>
          <div class="relative mt-1">
            <span class="absolute inset-y-0 left-3 flex items-center text-on-surface-variant">$</span>
            <input type="number" step="0.01" name="price_<%= size.id %>" id="pizzaPrice_<%= size.id %>" required min="0"
                   value="<%= prices && prices[size.id] ? prices[size.id].toFixed(2) : '' %>"
                   class="block w-full pl-8 pr-4 py-3 h-12 bg-surface-container border border-outline-variant text-on-surface rounded-none focus:ring-2 focus:ring-brand-red focus:border-brand-red transition">
          </div>
          <p id="pizzaPriceError_<%= size.id %>" class="text-brand-red text-xs mt-1 hidden">Precio debe ser ≥ 0.</p>
        </label>
      <% }) %>

      <div class="flex space-x-4 mt-8">
        <button type="submit" class="bg-brand-red hover:bg-red-800 text-white font-bold py-3 px-8 rounded-none transition">
          <%= pizza ? 'Guardar cambios' : 'Crear pizza' %>
        </button>
        <a href="/admin/pizzas" class="bg-surface-container-high text-on-surface font-medium py-3 px-8 rounded-none hover:bg-surface-container-highest transition">Cancelar</a>
      </div>
    </form>
  </div>

  <script>
    // ==================== VALIDACIONES PIZZA ====================
    const pizzaNameInput = document.getElementById('pizzaName');
    const pizzaNameError = document.getElementById('pizzaNameError');
    const pizzaDescInput = document.getElementById('pizzaDescription');
    const pizzaDescError = document.getElementById('pizzaDescError');
    const priceInputs = document.querySelectorAll('input[id^="pizzaPrice_"]');

    // Validar nombre
    function validatePizzaName() {
      const value = pizzaNameInput.value.trim();
      const regex = /^[A-Za-záéíóúüñÁÉÍÓÚÜÑ\s]+$/;
      if (value.length > 0 && !regex.test(value)) {
        pizzaNameError.classList.remove('hidden');
        pizzaNameInput.classList.add('border-red-500');
        return false;
      } else {
        pizzaNameError.classList.add('hidden');
        pizzaNameInput.classList.remove('border-red-500');
        return true;
      }
    }

    // Validar descripción (opcional)
    function validatePizzaDescription() {
      const value = pizzaDescInput.value.trim();
      if (value.length === 0) {
        pizzaDescError.classList.add('hidden');
        pizzaDescInput.classList.remove('border-red-500');
        return true;
      }
      const regex = /^[A-Za-záéíóúüñÁÉÍÓÚÜÑ\s.,]+$/;
      if (!regex.test(value)) {
        pizzaDescError.classList.remove('hidden');
        pizzaDescInput.classList.add('border-red-500');
        return false;
      } else {
        pizzaDescError.classList.add('hidden');
        pizzaDescInput.classList.remove('border-red-500');
        return true;
      }
    }

    // Validar un precio
    function validatePrice(input, errorEl) {
      const price = parseFloat(input.value);
      if (isNaN(price) || price < 0) {
        errorEl.classList.remove('hidden');
        input.classList.add('border-red-500');
        return false;
      } else {
        errorEl.classList.add('hidden');
        input.classList.remove('border-red-500');
        return true;
      }
    }

    // Eventos nombre
    pizzaNameInput.addEventListener('blur', validatePizzaName);
    pizzaNameInput.addEventListener('input', () => { if (validatePizzaName()) { pizzaNameError.classList.add('hidden'); pizzaNameInput.classList.remove('border-red-500'); } });

    // Eventos descripción
    pizzaDescInput.addEventListener('blur', validatePizzaDescription);
    pizzaDescInput.addEventListener('input', () => { if (validatePizzaDescription()) { pizzaDescError.classList.add('hidden'); pizzaDescInput.classList.remove('border-red-500'); } });

    // Eventos precios
    priceInputs.forEach(input => {
      const sizeId = input.id.split('_')[1];
      const errorEl = document.getElementById('pizzaPriceError_' + sizeId);

      input.addEventListener('blur', () => validatePrice(input, errorEl));
      input.addEventListener('input', () => { if (validatePrice(input, errorEl)) { errorEl.classList.add('hidden'); input.classList.remove('border-red-500'); } });

      // Bloquear teclas no numéricas
      input.addEventListener('keydown', function(e) {
        const allowedKeys = ['Backspace', 'Delete', 'ArrowLeft', 'ArrowRight', 'Tab', 'Escape', 'Home', 'End'];
        if (allowedKeys.includes(e.key)) return;
        if (e.key === '.' && !this.value.includes('.')) return;
        if (!/^\d$/.test(e.key)) e.preventDefault();
      });

      input.addEventListener('paste', function(e) {
        e.preventDefault();
        const pasted = (e.clipboardData || window.clipboardData).getData('text');
        let cleaned = pasted.replace(/[^0-9.]/g, '');
        const parts = cleaned.split('.');
        if (parts.length > 1) cleaned = parts[0] + '.' + parts.slice(1).join('');
        const num = parseFloat(cleaned);
        if (!isNaN(num) && num >= 0) this.value = num;
        else this.value = '';
        validatePrice(input, errorEl);
      });
    });

    // Envío
    document.querySelector('form').addEventListener('submit', function(e) {
      let isValid = true;
      if (!validatePizzaName()) { isValid = false; pizzaNameInput.focus(); }
      if (!validatePizzaDescription()) { isValid = false; if (isValid) pizzaDescInput.focus(); }
      priceInputs.forEach(input => {
        const sizeId = input.id.split('_')[1];
        const errorEl = document.getElementById('pizzaPriceError_' + sizeId);
        if (!validatePrice(input, errorEl)) { isValid = false; if (isValid) input.focus(); }
      });
      if (!isValid) e.preventDefault();
    });
  </script>
</body>
</html>