<!-- ============================================================
  VIEW: admin-orders.ejs — Gestión de pedidos (admin)
  ------------------------------------------------------------
  Filtros por nombre/teléfono/fecha, cambio de estado, imprimir
  comanda, ver comprobante, eliminar pedidos, y confirmar/
  rechazar pago. Variables: orders, nombre, telefono, fecha.
============================================================ -->
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <%- include('partials/head', { title: 'Pedidos - Admin' }) %>
</head>
<body class="bg-background text-on-surface flex">
  <%- include('admin-sidebar') %>
  <div class="ml-64 p-8 flex-1">
    <div class="flex justify-between items-center mb-8">
      <h1 class="text-4xl font-bold font-display text-on-surface">📋 Pedidos</h1>
      <button onclick="openConfirmModal('¿Eliminar TODOS los pedidos? Esta acción es irreversible.', '/admin/orders/delete-all')" 
              <%= orders.length === 0 ? 'disabled' : '' %>
              class="bg-brand-red hover:bg-red-700 text-white font-semibold px-5 py-2 rounded-none shadow-md hover:shadow-lg transition disabled:opacity-50 disabled:cursor-not-allowed">
        🗑️ Eliminar todos
      </button>
    </div>

    <form action="/admin/orders" method="GET" class="bg-surface-container border border-outline-variant rounded-none shadow-md p-4 mb-6 flex flex-col md:flex-row gap-4 items-end">
      <div class="flex-1">
        <label class="block text-sm font-medium text-on-surface-variant mb-1">Nombre</label>
        <input type="text" name="nombre" value="<%= nombre || '' %>" placeholder="Nombre del cliente"
              class="w-full px-4 py-2 bg-surface-container border border-outline-variant text-on-surface rounded-none focus:ring-2 focus:ring-brand-red focus:border-brand-red transition placeholder:text-on-surface-variant/60">
      </div>
      <div>
        <label class="block text-sm font-medium text-on-surface-variant mb-1">Teléfono</label>
        <input type="tel" name="telefono" id="telefonoFilter" value="<%= telefono || '' %>" placeholder="0000-0000000"
              class="px-4 py-2 bg-surface-container border border-outline-variant text-on-surface rounded-none focus:ring-2 focus:ring-brand-red focus:border-brand-red transition placeholder:text-on-surface-variant/60">
      </div>
      <div>
        <label class="block text-sm font-medium text-on-surface-variant mb-1">Fecha</label>
        <input type="date" name="fecha" value="<%= fecha || '' %>"
              class="px-4 py-2 bg-surface-container border border-outline-variant text-on-surface rounded-none focus:ring-2 focus:ring-brand-red focus:border-brand-red transition">
      </div>
      <button type="submit" class="bg-brand-red hover:bg-red-800 text-white font-semibold px-5 py-2 rounded-none shadow-md transition">Filtrar</button>
      <a href="/admin/orders" class="bg-surface-container-high hover:bg-surface-container-highest text-on-surface font-medium px-5 py-2 rounded-none transition">Limpiar</a>
    </form>

    <% if (success_msg && success_msg.length > 0) { %>
      <div class="bg-brand-green/10 border border-brand-green/40 text-green-300 px-4 py-3 rounded-none mb-6"><%= success_msg[0] %></div>
    <% } %>
    
    <% if (error_msg && error_msg.length > 0) { %>
      <div class="bg-brand-red/10 border border-brand-red/40 text-red-300 px-4 py-3 rounded-none mb-6"><%= error_msg[0] %></div>
    <% } %>

    <% 
      const filtroActivo = (nombre && nombre.trim() !== '') || 
                          (telefono && telefono.trim() !== '') || 
                          (fecha && fecha.trim() !== '');
    %>

    <% orders.forEach(order => { %>
      <% 
        const isCash = order.payment_method === 'Efectivo en local';
        const canUpdateStatus = isCash || order.payment_status === 'paid';
      %>
      <div class="bg-surface-container border border-outline-variant rounded-none shadow-md p-6 mb-6 hover:shadow-xl transition">
        <div class="flex flex-col md:flex-row justify-between">
          <div class="mb-4 md:mb-0">
            <div class="flex items-center gap-3">
              <span class="text-2xl font-bold font-display text-on-surface"><%= order.customer_name %></span>

              <!-- Badge estado operativo -->
              <span class="px-2 py-1 text-xs border
                <%= order.status === 'pending' ? 'bg-yellow-500/15 text-yellow-300 border-yellow-500/30' : 
                  order.status === 'ready' ? 'bg-green-500/15 text-green-300 border-green-500/30' : 
                  'bg-gray-500/20 text-gray-300 border-gray-500/30' %>">
                <%= order.status === 'pending' ? 'Pendiente' : 
                  order.status === 'ready' ? 'Listo' : 'Entregado' %>
              </span>

              <!-- Badge estado de pago (solo si no es efectivo) -->
              <% if (order.payment_method !== 'Efectivo en local') { %>
                <span class="px-2 py-1 text-xs border
                  <%= order.payment_status === 'paid' ? 'bg-green-500/15 text-green-300 border-green-500/30' : 
                    order.payment_status === 'rejected' ? 'bg-red-500/15 text-red-300 border-red-500/30' : 
                    order.payment_status === 'submitted' ? 'bg-blue-500/15 text-blue-300 border-blue-500/30' : 
                    'bg-yellow-500/15 text-yellow-300 border-yellow-500/30' %>">
                  <%= order.payment_status === 'paid' ? 'Pagado' : 
                    order.payment_status === 'rejected' ? 'Rechazado' : 
                    order.payment_status === 'submitted' ? 'Pago reportado' : 
                    'Pago pendiente' %>
                </span>
              <% } %>
            </div>
            <% if (order.payment_method !== 'Efectivo en local') { %>
              <div class="mt-2 text-xs text-on-surface-variant">
                <p><strong>Nº de referencia:</strong> <%= order.payment_ref || 'No proporcionado' %></p>
                <% if (order.payment_receipt) { %>
                  <button onclick="openReceiptModal('<%= order.payment_receipt %>')" class="text-brand-red hover:underline">📎 Ver comprobante</button>
                <% } else { %>
                  <p class="text-on-surface-variant/70">Sin comprobante</p>
                <% } %>
              </div>
            <% } %>
            <p class="text-on-surface-variant mt-2 flex items-center gap-4">
              <span>📞 <%= order.phone %></span>
              <span>🕒 <%= order.pickup_time %></span>
              <span>💳 <%= order.payment_method %></span>
            </p>
            <p class="text-xs text-on-surface-variant/70 mt-1">Pedido #<%= order.id %> · <%= new Date(order.created_at).toLocaleString() %></p>
          </div>
          <div class="flex items-start gap-4">
            <div class="text-right">
              <p class="text-3xl font-bold text-on-surface">$<%= order.total %></p>
              
              <div class="mt-2 flex flex-wrap gap-1">
                <form action="/admin/orders/<%= order.id %>/status" method="POST" class="inline">
                  <%- include('csrf') %>
                  <input type="hidden" name="status" value="pending">
                  <button type="submit" disabled 
                          class="px-3 py-1 text-xs border 
                                <%= order.status === 'pending' ? 'bg-yellow-500 text-yellow-950 border-yellow-500' : 'bg-surface-container text-yellow-300 border-yellow-500/40 opacity-40 cursor-not-allowed' %>">
                    Pendiente
                  </button>
                </form>

                <form action="/admin/orders/<%= order.id %>/status" method="POST" class="inline">
                  <%- include('csrf') %>
                  <input type="hidden" name="status" value="ready">
                  <button type="submit" <%= canUpdateStatus && order.status === 'pending' ? '' : 'disabled' %> 
                          class="px-3 py-1 text-xs border 
                                <%= order.status === 'ready' ? 'bg-brand-green text-white border-brand-green' : 
                                    (order.status === 'pending' && canUpdateStatus ? 'bg-surface-container text-green-300 border-green-500/40 hover:bg-green-500/10' : 'bg-surface-container text-green-300 border-green-500/40 opacity-40 cursor-not-allowed') %>">
                    Listo
                  </button>
                </form>

                <form action="/admin/orders/<%= order.id %>/status" method="POST" class="inline">
                  <%- include('csrf') %>
                  <input type="hidden" name="status" value="delivered">
                  <button type="submit" <%= canUpdateStatus && order.status === 'ready' ? '' : 'disabled' %> 
                          class="px-3 py-1 text-xs border 
                                <%= order.status === 'delivered' ? 'bg-gray-500 text-white border-gray-500' : 
                                    (order.status === 'ready' && canUpdateStatus ? 'bg-surface-container text-gray-300 border-gray-500/40 hover:bg-gray-500/10' : 'bg-surface-container text-gray-300 border-gray-500/40 opacity-40 cursor-not-allowed') %>">
                    Entregado
                  </button>
                </form>
              </div>

              <% if (!isCash && order.payment_status === 'submitted') { %>
                <div class="mt-2 flex gap-2">
                  <form action="/admin/orders/<%= order.id %>/payment" method="POST">
                    <%- include('csrf') %>
                    <input type="hidden" name="payment_status" value="paid">
                    <button type="submit" class="bg-brand-green hover:bg-green-700 text-white text-xs px-3 py-1 rounded-none">Confirmar pago</button>
                  </form>
                  <form action="/admin/orders/<%= order.id %>/payment" method="POST">
                    <%- include('csrf') %>
                    <input type="hidden" name="payment_status" value="rejected">
                    <button type="submit" class="bg-brand-red hover:bg-red-700 text-white text-xs px-3 py-1 rounded-none">Rechazar pago</button>
                  </form>
                </div>
              <% } %>
            </div>
            <% if (canUpdateStatus) { %>
              <a href="/admin/orders/<%= order.id %>/print" target="_blank" 
                class="bg-surface-container-high hover:bg-surface-container-highest text-on-surface p-2 rounded-none transition" title="Imprimir">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4H8v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
              </a>
            <% } else { %>
              <span class="bg-surface-container text-on-surface-variant opacity-50 p-2 rounded-none cursor-not-allowed" title="Imprimir (pago no validado)">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4H8v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
              </span>
            <% } %>
            <button onclick="openConfirmModal('¿Eliminar el pedido #<%= order.id %> de <%= order.customer_name %>?', '/admin/orders/delete/<%= order.id %>')" 
                    class="bg-surface-container-high hover:bg-surface-container-highest text-brand-red p-2 rounded-none transition" title="Eliminar">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
            </button>
          </div>
        </div>
        <hr class="my-4 border-outline-variant">
        <ul class="space-y-1">
          <% if (order.items) { %>
            <% order.items.forEach(item => { %>
              <li class="text-on-surface-variant">
                <span class="font-medium"><%= item.quantity %>x <%= item.pizza_name %></span> (<%= item.size_label %>)
                <% if (item.toppings.length) { %> + <%= item.toppings.join(', ') %><% } %>
                = $<%= item.line_total.toFixed(2) %>
              </li>
            <% }) %>
          <% } %>
        </ul>
      </div>
    <% }) %>

    <% if (orders.length === 0) { %>
      <% if (filtroActivo) { %>
        <div class="text-center py-10 text-on-surface-variant/70">
          No se encontraron pedidos con los filtros seleccionados.
        </div>
      <% } else { %>
        <div class="text-center py-10 text-on-surface-variant/70">
          No hay pedidos todavía.
        </div>
      <% } %>
    <% } %>

  </div>

  <!-- Modal para ver comprobante -->
<div id="receiptModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/70 p-4">
  <div class="bg-surface-container-high border border-outline-variant rounded-none shadow-2xl max-w-lg w-full p-6">
    <div class="flex justify-between items-center mb-4">
      <h3 class="text-lg font-bold font-display text-on-surface">Comprobante de pago</h3>
      <button onclick="closeReceiptModal()" class="text-on-surface-variant hover:text-brand-red text-2xl">&times;</button>
    </div>
    <img id="receiptImage" src="" alt="Comprobante de pago" class="w-full h-auto max-h-[70vh] object-contain">
  </div>
</div>

<script>
  function openReceiptModal(src) {
    document.getElementById('receiptImage').src = src;
    const modal = document.getElementById('receiptModal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
  }

  function closeReceiptModal() {
    const modal = document.getElementById('receiptModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
  }

  document.getElementById('receiptModal').addEventListener('click', function(e) {
    if (e.target === this) closeReceiptModal();
  });
</script>
  <%- include('modal-confirm') %>

  <script src="/socket.io/socket.io.js"></script>
  <script>
    // Asegurarse de que el contenedor de toasts existe (ya lo hace el sidebar)
    socket.on('nuevo_pedido', (order) => {
      // Mostrar notificación
      showToast(`Nuevo pedido de ${order.customer_name} por $${order.total}`, 'success');
      // Recargar la página para actualizar la lista
      location.reload();
    });
    socket.on('pago_realizado', () => {
      location.reload();
    });
  </script>

  <script>
    const telefonoFilter = document.getElementById('telefonoFilter');

    telefonoFilter.addEventListener('input', function(e) {
      let value = this.value.replace(/\D/g, '');
      if (value.length >= 4) {
        value = value.substring(0,4) + '-' + value.substring(4,11);
      }
      this.value = value;
    });

    telefonoFilter.addEventListener('paste', function(e) {
      e.preventDefault();
      const cleaned = (e.clipboardData || window.clipboardData).getData('text').replace(/\D/g, '');
      let formatted = cleaned.substring(0,4);
      if (cleaned.length > 4) formatted += '-' + cleaned.substring(4,11);
      this.value = formatted;
    });
  </script>

</body>
</html>