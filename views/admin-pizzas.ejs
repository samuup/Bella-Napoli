<!-- ============================================================
  VIEW: admin-pizzas.ejs — Administración de pizzas (listado)
  ------------------------------------------------------------
  Variables: pizzas.
============================================================ -->
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <%- include('partials/head', { title: 'Pizzas - Admin' }) %>
</head>
<body class="bg-background text-on-surface flex">
  <%- include('admin-sidebar') %>
  <div class="ml-64 p-8 flex-1">
    <div class="flex justify-between items-center mb-8">
      <h1 class="text-4xl font-bold font-display text-on-surface">🍕 Pizzas</h1>
      <a href="/admin/pizzas/add" class="bg-brand-red hover:bg-red-800 text-white px-6 py-3 rounded-none font-semibold shadow-md hover:shadow-lg transition flex items-center gap-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        Nueva pizza
      </a>
    </div>

    <% if (success_msg && success_msg.length > 0) { %>
      <div class="bg-brand-green/10 border border-brand-green/40 text-green-300 px-4 py-3 rounded-none mb-6"><%= success_msg[0] %></div>
    <% } %>

    <% if (error_msg && error_msg.length > 0) { %>
      <div class="bg-brand-red/10 border border-brand-red/40 text-red-300 px-4 py-3 rounded-none mb-6"><%= error_msg[0] %></div>
    <% } %>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% pizzas.forEach(pizza => { %>
        <div class="bg-surface-container border border-outline-variant rounded-none shadow-md hover:shadow-xl transition overflow-hidden">
          <div class="p-6">
            <div class="flex items-start justify-between">
              <div>
                <h3 class="text-2xl font-bold font-display text-on-surface"><%= pizza.name %></h3>
                <p class="text-on-surface-variant mt-1"><%= pizza.description || 'Sin descripción' %></p>
              </div>
              <span class="text-4xl"><%= pizza.active ? '🟢' : '🔴' %></span>
            </div>
            <div class="mt-4 flex justify-between items-center">
              <span class="text-xs font-medium px-2 py-1 border <%= pizza.active ? 'bg-green-500/15 text-green-300 border-green-500/30' : 'bg-red-500/15 text-red-300 border-red-500/30' %>">
                <%= pizza.active ? 'Activa' : 'Inactiva' %>
              </span>
              <div class="flex space-x-2">
                <a href="/admin/pizzas/edit/<%= pizza.id %>" class="text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface p-2 rounded-none transition" title="Editar">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                </a>
                <button onclick="openConfirmModal('¿Eliminar <%= pizza.name %>?', '/admin/pizzas/delete/<%= pizza.id %>')" class="text-brand-red hover:bg-surface-container-high p-2 rounded-none transition" title="Eliminar">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                </button>
              </div>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
  <%- include('modal-confirm') %>
</body>
</html>