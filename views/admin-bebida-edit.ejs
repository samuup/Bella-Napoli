<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Editar Bebida - Admin</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; }
    h1, h2, h3, .font-serif { font-family: 'Playfair Display', serif; }
  </style>
</head>
<body class="bg-stone-50 flex">
  <%- include('admin-sidebar') %>
  <div class="ml-64 p-8 flex-1">
    <h1 class="text-4xl font-bold font-serif text-stone-800 mb-8">Editar Bebida</h1>
    <% if (error_msg && error_msg.length > 0) { %>
      <div class="bg-red-100 border border-red-300 text-red-800 px-4 py-3 rounded-2xl mb-6">
        <%= error_msg[0] %>
      </div>
    <% } %>
    <% if (error) { %>
      <div class="bg-red-100 border border-red-300 text-red-800 px-4 py-3 rounded-2xl mb-6"><%= error %></div>
    <% } %>
    <form action="/admin/bebidas/edit/<%= bebida.id %>" method="POST" class="bg-white rounded-2xl shadow-md p-6 max-w-md">
      <%- include('csrf') %>
      <label class="block mb-4">
        <span class="text-stone-700 font-medium">Nombre</span>
        <input type="text" name="name" id="editBebidaName" required value="<%= bebida.name %>"
               pattern="^[A-Za-záéíóúüñÁÉÍÓÚÜÑ\s]+$" title="Solo letras y espacios"
               class="mt-1 block w-full border border-stone-300 rounded-xl p-3 focus:ring-2 focus:ring-red-500 focus:border-red-500 transition">
        <p id="editBebidaNameError" class="text-red-500 text-xs mt-1 hidden">Solo letras y espacios permitidos.</p>
      </label>
      <label class="block mb-4">
        <span class="text-stone-700 font-medium">Precio</span>
        <div class="relative mt-1">
          <span class="absolute inset-y-0 left-3 flex items-center text-stone-500">$</span>
          <input type="number" name="price" id="editBebidaPrice" required min="0" step="0.01" value="<%= bebida.price %>"
                 class="block w-full pl-8 pr-4 py-3 h-12 border border-stone-300 rounded-xl focus:ring-2 focus:ring-red-500 focus:border-red-500 transition">
        </div>
        <p id="editBebidaPriceError" class="text-red-500 text-xs mt-1 hidden">Precio debe ser ≥ 0.</p>
      </label>
      <label class="block mb-6">
        <span class="text-stone-700 font-medium">Activa</span>
        <select name="active" class="mt-1 block w-full border border-stone-300 rounded-xl p-3 focus:ring-2 focus:ring-red-500 focus:border-red-500 transition">
          <option value="1" <%= bebida.active ? 'selected' : '' %>>Sí</option>
          <option value="0" <%= !bebida.active ? 'selected' : '' %>>No</option>
        </select>
      </label>
      <div class="flex space-x-4">
        <button type="submit" class="bg-red-700 hover:bg-red-800 text-white font-bold py-2 px-6 rounded-full transition">Guardar</button>
        <a href="/admin/bebidas" class="bg-stone-200 text-stone-700 font-medium py-2 px-6 rounded-full hover:bg-stone-300 transition">Cancelar</a>
      </div>
    </form>
  </div>

  <script>
    const nameInput = document.getElementById('editBebidaName');
    const priceInput = document.getElementById('editBebidaPrice');
    const nameError = document.getElementById('editBebidaNameError');
    const priceError = document.getElementById('editBebidaPriceError');

    function validateName() {
      const value = nameInput.value.trim();
      const regex = /^[A-Za-záéíóúüñÁÉÍÓÚÜÑ\s]+$/;
      if (value.length > 0 && !regex.test(value)) {
        nameError.classList.remove('hidden');
        nameInput.classList.add('border-red-500');
        return false;
      } else {
        nameError.classList.add('hidden');
        nameInput.classList.remove('border-red-500');
        return true;
      }
    }

    function validatePrice() {
      const price = parseFloat(priceInput.value);
      if (isNaN(price) || price < 0) {
        priceError.classList.remove('hidden');
        priceInput.classList.add('border-red-500');
        return false;
      } else {
        priceError.classList.add('hidden');
        priceInput.classList.remove('border-red-500');
        return true;
      }
    }

    nameInput.addEventListener('blur', validateName);
    nameInput.addEventListener('input', () => { if (validateName()) { nameError.classList.add('hidden'); nameInput.classList.remove('border-red-500'); } });
    priceInput.addEventListener('blur', validatePrice);
    priceInput.addEventListener('input', () => { if (validatePrice()) { priceError.classList.add('hidden'); priceInput.classList.remove('border-red-500'); } });

    priceInput.addEventListener('keydown', function(e) {
      const allowed = ['Backspace','Delete','ArrowLeft','ArrowRight','Tab','Escape','Home','End'];
      if (allowed.includes(e.key)) return;
      if (e.key === '.' && !this.value.includes('.')) return;
      if (!/^\d$/.test(e.key)) e.preventDefault();
    });

    priceInput.addEventListener('paste', function(e) {
      e.preventDefault();
      const pasted = (e.clipboardData || window.clipboardData).getData('text');
      let cleaned = pasted.replace(/[^0-9.]/g, '');
      const parts = cleaned.split('.');
      if (parts.length > 1) cleaned = parts[0] + '.' + parts.slice(1).join('');
      const num = parseFloat(cleaned);
      if (!isNaN(num) && num >= 0) this.value = num;
      else this.value = '';
      validatePrice();
    });

    document.querySelector('form').addEventListener('submit', function(e) {
      if (!validateName() || !validatePrice()) {
        e.preventDefault();
        if (!validateName()) nameInput.focus(); else priceInput.focus();
      }
    });
  </script>
</body>
</html>